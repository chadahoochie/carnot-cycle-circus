@using CarnotCycleCircus.Core.Domain.Artifacts
@using CarnotCycleCircus.Core.Domain.Agents
@using CarnotCycleCircus.Core.Domain.Tickets
@using CarnotCycleCircus.Core.Domain.Projects
@using CarnotCycleCircus.Core.Domain.Inference
@inject ITicketStore TicketStore
@inject IHandoffRouter HandoffRouter
@inject IGraphWorkflowExecutor GraphExecutor
@inject IArtifactManager ArtifactManager
@inject IJSRuntime JSRuntime
@inject IProjectManager ProjectManager

<div class="modal-backdrop" @onclick="Close">
    <div class="modal-dialog" style="max-width: 860px; max-height: 92vh; display: flex; flex-direction: column; overflow: hidden;" @onclick:stopPropagation="true">
        <div class="modal-header" style="flex-shrink: 0;">
            <div style="display: flex; align-items: center; gap: 10px; flex: 1; margin-right: 12px;">
                <span class="badge" style="background: @Ticket.AssigneeRole.ToColorHex(); color: #000; font-weight: 700; font-size: 0.82rem;">@Ticket.Id</span>
                <input type="text" class="form-control" style="font-size: 1.1rem; font-weight: 700; color: #f8fafc; background: rgba(15, 23, 42, 0.7); border: 1px solid var(--border-color); padding: 5px 10px; border-radius: 6px; flex: 1;"
                       @bind="editTitle" placeholder="Ticket Title..." />
                @if (Ticket.ProjectId is { } projectId && ProjectManager.GetById(projectId) is { } project)
                {
                    <span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid #38bdf8; font-weight: 600;" title="Project">
                        📁 @project.Name
                    </span>
                }
            </div>
            <button class="btn btn-secondary" @onclick="Close" style="padding: 4px 8px;">✕</button>
        </div>

        <div class="modal-body" style="overflow-y: auto; flex: 1;">
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px;">
                <div>
                    <div style="margin-bottom: 16px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                            <h4 style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; margin: 0;">Description</h4>
                            <span style="font-size: 0.72rem; color: #38bdf8;">Editable</span>
                        </div>
                        <textarea class="form-control" style="background: var(--bg-primary); padding: 10px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 0.88rem; line-height: 1.5; width: 100%; min-height: 110px; color: #f8fafc; resize: vertical;"
                                  @bind="editDescription" placeholder="Ticket description..."></textarea>
                    </div>

                    <div style="margin-bottom: 16px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                            <h4 style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; margin: 0;">Acceptance Criteria</h4>
                            <span style="font-size: 0.72rem; color: #38bdf8;">One criterion per line</span>
                        </div>
                        <textarea class="form-control" style="background: var(--bg-primary); padding: 10px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 0.82rem; font-family: monospace; width: 100%; min-height: 90px; color: #f8fafc; resize: vertical;"
                                  @bind="editCriteriaText" placeholder="Enter acceptance criteria, one per line..."></textarea>
                    </div>

                    @if (Ticket.Deliverables.Count > 0)
                    {
                        <div style="margin-bottom: 16px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                <h4 style="font-size: 0.85rem; font-weight: 600; color: #22c55e; text-transform: uppercase; margin: 0;">
                                    Delivered Artifacts (@Ticket.Deliverables.Count)
                                </h4>
                                <a href="artifacts" style="font-size: 0.75rem; color: #38bdf8; text-decoration: none;">
                                    View in Artifacts Hub ↗
                                </a>
                            </div>

                            <div style="display: flex; flex-direction: column; gap: 10px;">
                                @foreach (var artifact in Ticket.Deliverables)
                                {
                                    var artifactPath = ArtifactManager.GetArtifactPath(Ticket.Id, artifact.Name);
                                    var relPath = $"artifacts/tickets/{Ticket.Id}/{artifact.Name}";
                                    <div style="background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 8px; overflow: hidden;">
                                        <div style="background: var(--bg-tertiary); padding: 8px 12px; font-size: 0.8rem; font-weight: 600; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 6px;">
                                            <div>
                                                <span>📄 @artifact.Name</span>
                                                <span style="color: var(--text-muted); font-size: 0.72rem; margin-left: 6px;">(@artifact.ContentType)</span>
                                            </div>
                                            <div style="display: flex; gap: 6px;">
                                                <button class="btn btn-secondary" style="font-size: 0.7rem; padding: 2px 8px;" @onclick="() => CopyPath(artifactPath)">
                                                    📋 Copy Path
                                                </button>
                                                <button class="btn btn-primary" style="font-size: 0.7rem; padding: 2px 8px;" @onclick="() => CopyContent(artifact.Content)">
                                                    📋 Copy Content
                                                </button>
                                            </div>
                                        </div>
                                        <div style="background: rgba(0,0,0,0.25); padding: 4px 12px; font-family: monospace; font-size: 0.72rem; color: #38bdf8; border-bottom: 1px solid var(--border-color);">
                                            📁 @relPath
                                        </div>
                                        <pre style="padding: 10px; font-size: 0.8rem; overflow-x: auto; max-height: 220px; font-family: monospace; margin: 0;">@artifact.Content</pre>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Right Sidebar Details -->
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <div style="background: var(--bg-primary); padding: 14px; border-radius: 8px; border: 1px solid var(--border-color);">
                        @if (Ticket.Status != TicketStatus.Done)
                        {
                            var isReady = TicketStore.AreDependenciesSatisfied(Ticket.Id);
                            <div style="margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color);">
                                <button class="btn btn-success" style="width: 100%; justify-content: center; font-weight: 700; padding: 8px 12px;"
                                        @onclick="ExecuteTicketWithAgent"
                                        disabled="@(!isReady || isExecuting)">
                                    @(isExecuting ? "⏳ Agent Working..." : isReady ? $"🚀 Unleash {Ticket.AssigneeRole.ToDisplayName().Split(' ')[0]}" : "⏳ Dependencies Pending")
                                </button>
                                @if (!isReady && Ticket.DependsOnTicketIds.Count > 0)
                                {
                                    <div style="font-size: 0.72rem; color: #eab308; margin-top: 6px; text-align: center;">
                                        Blocked by: @string.Join(", ", Ticket.DependsOnTicketIds)
                                    </div>
                                }
                            </div>
                        }

                        @if (Ticket.Status == TicketStatus.Blocked)
                        {
                            <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; border-radius: 6px; padding: 10px; margin-bottom: 12px; font-size: 0.78rem;">
                                <div style="color: #ef4444; font-weight: 700; margin-bottom: 4px;">⚠️ Ticket Execution Blocked</div>
                                <div style="color: #cbd5e1; font-size: 0.72rem; margin-bottom: 8px;">An error occurred during agent inference or model connection.</div>
                                <button class="btn btn-secondary" style="width: 100%; font-size: 0.75rem; padding: 4px 8px; justify-content: center;" @onclick="ResetToReady">
                                    🔄 Reset Status to Ready
                                </button>
                            </div>
                        }

                        <div style="margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color);">
                            <button class="btn btn-secondary" style="width: 100%; justify-content: center; font-size: 0.8rem; padding: 7px 10px; display: flex; align-items: center; gap: 6px;"
                                    @onclick="() => showActivityModal = true">
                                🔬 Inspect Agent Activity
                            </button>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Status</label>
                            <select class="form-control" @bind="selectedStatus">
                                @foreach (var status in Enum.GetValues<TicketStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Priority</label>
                            <select class="form-control" @bind="selectedPriority">
                                @foreach (var priority in Enum.GetValues<TicketPriority>())
                                {
                                    <option value="@priority">@priority</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Assignee Role</label>
                            <select class="form-control" @bind="selectedAssignee">
                                @foreach (var role in Enum.GetValues<AgentRole>())
                                {
                                    <option value="@role">@role.ToEmoji() @role.ToDisplayName()</option>
                                }
                            </select>
                        </div>

                        <div style="margin-top: 14px;">
                            <button class="btn btn-primary" style="width: 100%; justify-content: center; font-weight: 600;" @onclick="SaveUpdates">
                                💾 Save Changes
                            </button>
                        </div>
                    </div>

                    @if (Ticket.DependsOnTicketIds.Count > 0)
                    {
                        <div style="background: var(--bg-primary); padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                            <div style="font-size: 0.8rem; font-weight: 600; color: #eab308; margin-bottom: 6px;">Dependencies:</div>
                            @foreach (var depId in Ticket.DependsOnTicketIds)
                            {
                                var dep = TicketStore.GetTicketById(depId);
                                <div style="font-size: 0.78rem; margin-bottom: 4px;">
                                    <span style="color: #38bdf8;">@depId</span>: @(dep?.Status == TicketStatus.Done ? "✅ Done" : "⏳ Pending")
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="modal-footer" style="flex-shrink: 0; display: flex; justify-content: space-between; align-items: center;">
            <button class="btn btn-primary" @onclick="SaveUpdates" style="font-size: 0.8rem; padding: 5px 14px;">
                💾 Save Changes
            </button>
            <button class="btn btn-secondary" @onclick="Close">Close</button>
        </div>
    </div>
</div>

@if (showActivityModal)
{
    <AgentActivityModal TicketId="@Ticket.Id" OnClose="() => showActivityModal = false" />
}

@code {
    [Parameter, EditorRequired] public TicketItem Ticket { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnUpdated { get; set; }

    private string editTitle = "";
    private string editDescription = "";
    private string editCriteriaText = "";
    private TicketPriority selectedPriority;
    private TicketStatus selectedStatus;
    private AgentRole selectedAssignee;
    private bool isExecuting = false;
    private bool showActivityModal = false;

    protected override void OnParametersSet()
    {
        editTitle = Ticket.Title;
        editDescription = Ticket.Description;
        editCriteriaText = string.Join("\n", Ticket.AcceptanceCriteria);
        selectedPriority = Ticket.Priority;
        selectedStatus = Ticket.Status;
        selectedAssignee = Ticket.AssigneeRole;
    }

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task ExecuteTicketWithAgent()
    {
        isExecuting = true;
        try
        {
            await GraphExecutor.ExecuteTicketAsync(Ticket.Id);
            var refreshed = TicketStore.GetTicketById(Ticket.Id);
            if (refreshed != null)
            {
                Ticket = refreshed;
                editTitle = refreshed.Title;
                editDescription = refreshed.Description;
                editCriteriaText = string.Join("\n", refreshed.AcceptanceCriteria);
                selectedPriority = refreshed.Priority;
                selectedStatus = refreshed.Status;
                selectedAssignee = refreshed.AssigneeRole;
            }
            await OnUpdated.InvokeAsync();
        }
        catch (Exception)
        {
            // Error already recorded in event stream and ticket status
        }
        finally
        {
            isExecuting = false;
        }
    }

    private void ResetToReady()
    {
        selectedStatus = TicketStatus.Ready;
        var updated = Ticket.WithStatus(TicketStatus.Ready);
        TicketStore.UpdateTicket(updated);
        Ticket = updated;
    }

    private async Task SaveUpdates()
    {
        var criteria = editCriteriaText
            .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        var updated = Ticket
            .WithTitle(string.IsNullOrWhiteSpace(editTitle) ? Ticket.Title : editTitle.Trim())
            .WithDescription(editDescription.Trim())
            .WithPriority(selectedPriority)
            .WithAcceptanceCriteria(criteria)
            .WithStatus(selectedStatus)
            .WithAssignee(selectedAssignee);

        TicketStore.UpdateTicket(updated);
        Ticket = updated;

        if (selectedStatus == TicketStatus.Done)
        {
            HandoffRouter.AdvanceWorkflowOnTicketCompletion(Ticket.Id);
        }
        await OnUpdated.InvokeAsync();
        await Close();
    }

    private async Task CopyPath(string path)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", path);
        }
        catch { }
    }

    private async Task CopyContent(string content)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", content);
        }
        catch { }
    }
}
