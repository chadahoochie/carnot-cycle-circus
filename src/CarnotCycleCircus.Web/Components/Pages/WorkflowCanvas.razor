@page "/canvas"
@implements IDisposable
@inject IGraphWorkflowExecutor GraphExecutor
@inject IAgentEventStream EventStream
@inject ITicketStore TicketStore

<div class="page-header">
    <div>
        <h2 style="font-size: 1.5rem; font-weight: 700;">🎨 Rube Goldberg Canvas & Failure Recovery Ports</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Interactive visual DAG editor with 🟢 Input, 🔵 Output, and 🔴 Failure/Remediation circuit breaker ports.</p>
    </div>

    <!-- Execution & Action Bar -->
    <div class="page-header-actions">
        <select class="form-control" style="width: auto; min-width: 200px; max-width: 100%;" @onchange="OnPresetSelected">
            <option value="preset-standard">🎪 Standard 6-Role Circus</option>
            <option value="preset-rapid">⚡ Rapid Prototype</option>
            <option value="preset-zero-trust">🔒 Zero-Trust Security</option>
            <option value="preset-performance">🏎️ High Performance</option>
        </select>

        <button class="btn btn-secondary" @onclick="OpenAddNodeModal" style="white-space: nowrap;">
            ➕ Add Node
        </button>

        <button class="btn btn-primary" @onclick="() => RunWorkflow(false)" disabled="@GraphExecutor.IsRunning" style="white-space: nowrap;">
            🚀 Unleash Workflow
        </button>

        <button class="btn btn-danger" @onclick="() => RunWorkflow(true)" disabled="@GraphExecutor.IsRunning" style="white-space: nowrap;">
            🚨 Panic / Failure Sim
        </button>

        <button class="btn btn-secondary" @onclick="StepNext" disabled="@GraphExecutor.IsRunning" style="white-space: nowrap;">
            ⏭️ Step Node
        </button>

        <button class="btn btn-secondary" @onclick="ResetCanvas" style="white-space: nowrap;">
            🔄 Reset Graph
        </button>

        <button class="btn btn-secondary" @onclick="OpenExportModal" style="white-space: nowrap;">
            💾 Export JSON
        </button>

        <button class="btn btn-secondary" @onclick="OpenImportModal" style="white-space: nowrap;">
            📥 Import JSON
        </button>

        <a href="dashboard" class="btn btn-secondary" style="white-space: nowrap;">
            ⚡ Panic Dashboard
        </a>
    </div>
</div>

<!-- Active Wiring Notification Banner -->
@if (_isConnecting)
{
    <div style="padding: 10px 16px; border-radius: 8px; margin-bottom: 14px; background: rgba(56, 189, 248, 0.15); border: 2px dashed #38bdf8; color: #38bdf8; font-size: 0.9rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            <span style="font-size: 1.2rem;">🔌</span>
            <span>
                <strong>Cabling Mode Active:</strong> Drawing cable from 
                <strong>@(_sourceConnectingNode?.Name ?? _sourceConnectingNodeId)</strong> 
                (@(_sourceConnectingPort == PortType.Failure ? "🔴 Failure Port" : "🔵 Output Port")). 
                Click on any 🟢 <strong>Input Port</strong> on a target node to complete connection.
            </span>
        </div>
        <button class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.8rem; white-space: nowrap;" @onclick="CancelConnecting">✕ Cancel Cabling</button>
    </div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div style="padding: 10px 16px; border-radius: 8px; margin-bottom: 14px; background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #fca5a5; font-size: 0.88rem; display: flex; justify-content: space-between; align-items: center;">
        <span>⚠️ @_errorMessage</span>
        <button style="background: transparent; border: none; color: #fca5a5; cursor: pointer; font-weight: bold;" @onclick="() => _errorMessage = null">✕</button>
    </div>
}

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div style="padding: 10px 16px; border-radius: 8px; margin-bottom: 14px; background: rgba(34, 197, 94, 0.15); border: 1px solid #22c55e; color: #86efac; font-size: 0.88rem; display: flex; justify-content: space-between; align-items: center;">
        <span>✅ @_successMessage</span>
        <button style="background: transparent; border: none; color: #86efac; cursor: pointer; font-weight: bold;" @onclick="() => _successMessage = null">✕</button>
    </div>
}

<!-- Visual Interactive Canvas Viewport -->
<div class="glass-card" 
     style="padding: 0; overflow: auto; position: relative; height: 540px; width: 100%; max-width: 100%; min-width: 0; background: radial-gradient(#1e293b 1px, transparent 1px); background-size: 24px 24px; border: 1px solid var(--border-color); border-radius: 12px;"
     @onmousemove="HandleCanvasMouseMove"
     @onmouseup="HandleCanvasMouseUp"
     @onmouseleave="HandleCanvasMouseUp">

    <div style="position: relative; width: 1150px; height: 530px;">
    
        <!-- SVG Connection Lines -->
        <svg style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;">
            <defs>
                <marker id="arrow-output" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M 0 0 L 10 5 L 0 10 z" fill="#38bdf8" />
                </marker>
                <marker id="arrow-failure" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M 0 0 L 10 5 L 0 10 z" fill="#ef4444" />
                </marker>
                <marker id="arrow-draft" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M 0 0 L 10 5 L 0 10 z" fill="#eab308" />
                </marker>
            </defs>

            <!-- Render Existing Connections -->
            @foreach (var conn in GraphExecutor.CurrentGraph.Connections)
            {
                var src = GraphExecutor.CurrentGraph.Nodes.FirstOrDefault(n => n.Id == conn.SourceNodeId);
                var tgt = GraphExecutor.CurrentGraph.Nodes.FirstOrDefault(n => n.Id == conn.TargetNodeId);

                if (src != null && tgt != null)
                {
                    var isFail = conn.SourcePort == PortType.Failure;
                    var x1 = src.X + (isFail ? 80 : 160);
                    var y1 = src.Y + (isFail ? 90 : 45);
                    var x2 = tgt.X;
                    var y2 = tgt.Y + 45;

                    var strokeColor = isFail ? "#ef4444" : "#38bdf8";
                    var marker = isFail ? "url(#arrow-failure)" : "url(#arrow-output)";
                    var dash = isFail ? "5,5" : "none";

                    var isCableActive = GraphExecutor.IsRunning && (src.State == NodeExecutionState.Running || src.State == NodeExecutionState.Remediating);
                    var activeClass = isCableActive ? "cable-active-pulse" : "";

                    <g style="pointer-events: auto; cursor: pointer;">
                        <!-- Transparent thicker line for easier clicking -->
                        <path d="M @x1 @y1 C @((x1+x2)/2) @y1, @((x1+x2)/2) @y2, @x2 @y2"
                              fill="none"
                              stroke="transparent"
                              stroke-width="14"
                              @onclick="() => Disconnect(conn)">
                            <title>Click to disconnect cable: @conn.SourceNodeId (@conn.SourcePort) -> @conn.TargetNodeId</title>
                        </path>

                        <!-- Visible styled cable line -->
                        <path d="M @x1 @y1 C @((x1+x2)/2) @y1, @((x1+x2)/2) @y2, @x2 @y2"
                              fill="none"
                              stroke="@strokeColor"
                              stroke-width="2.5"
                              stroke-dasharray="@dash"
                              marker-end="@marker"
                              class="cable-line @activeClass"
                              @onclick="() => Disconnect(conn)">
                            <title>Click to disconnect cable: @conn.SourceNodeId (@conn.SourcePort) -> @conn.TargetNodeId</title>
                        </path>
                    </g>
                }
            }

            <!-- Render Draft Cable in Connection Mode -->
            @if (_isConnecting)
            {
                <path d="M @_draftStartX @_draftStartY C @((_draftStartX + _currentMouseX)/2) @_draftStartY, @((_draftStartX + _currentMouseX)/2) @_currentMouseY, @_currentMouseX @_currentMouseY"
                      fill="none"
                      stroke="#eab308"
                      stroke-width="2.5"
                      stroke-dasharray="6,4"
                      marker-end="url(#arrow-draft)" />
            }
        </svg>

        <!-- Visual Draggable Nodes -->
        @foreach (var node in GraphExecutor.CurrentGraph.Nodes)
        {
            var pulseClass = node.State switch
            {
                NodeExecutionState.Running => "pulse-running",
                NodeExecutionState.Remediating => "pulse-remediating",
                _ => ""
            };

            var isSelected = _selectedNodeId == node.Id;
            var selectedClass = isSelected ? "node-selected" : "";

            <div style="left: @(node.X)px; top: @(node.Y)px; border: 2px solid @node.Role.ToColorHex();"
                 class="node-card @pulseClass @selectedClass"
                 @onmousedown="e => StartDrag(e, node.Id)"
                 @onclick="() => SelectNode(node.Id)">
                
                <!-- Input Port (Green) -->
                <div style="position: absolute; left: -8px; top: 38px; background: #10b981;"
                     class="port-handle @(_isConnecting ? "port-target-highlight" : "")"
                     title="🟢 Input Port (Click to connect inbound cable)"
                     @onclick:stopPropagation="true"
                     @onclick="() => HandleInputPortClick(node.Id)">
                </div>

                <!-- Output Port (Blue) -->
                <div style="position: absolute; right: -8px; top: 38px; background: #38bdf8;"
                     class="port-handle"
                     title="🔵 Output Port (Click to draw outbound cable)"
                     @onclick:stopPropagation="true"
                     @onclick="() => StartConnecting(node.Id, PortType.Output)">
                </div>

                <!-- Failure Port (Red) -->
                <div style="position: absolute; bottom: -8px; left: 72px; background: #ef4444;"
                     class="port-handle"
                     title="🔴 Failure / Remediation Port (Click to draw loopback cable)"
                     @onclick:stopPropagation="true"
                     @onclick="() => StartConnecting(node.Id, PortType.Failure)">
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
                    <div style="display: flex; align-items: center; gap: 6px; overflow: hidden;">
                        <span style="font-size: 1.1rem;">@node.Role.ToEmoji()</span>
                        <div style="font-size: 0.8rem; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            @node.Name
                        </div>
                    </div>
                    @if (node.RetryCount > 0)
                    {
                        <span class="badge" style="background: rgba(239, 68, 68, 0.2); color: #ef4444; font-size: 0.65rem; padding: 1px 4px;">
                            🔁 @node.RetryCount
                        </span>
                    }
                </div>

                <div style="font-size: 0.68rem; color: var(--text-muted); margin-bottom: 6px;">@node.Role.ToDisplayName()</div>

                <div style="font-size: 0.68rem; padding: 2px 6px; border-radius: 4px; text-align: center; font-weight: 600; background: rgba(255,255,255,0.06); color: @(node.State == NodeExecutionState.Completed ? "#22c55e" : node.State == NodeExecutionState.Failed ? "#ef4444" : node.State == NodeExecutionState.Remediating ? "#f59e0b" : "#38bdf8");">
                    @node.State
                </div>
            </div>
        }
    </div>
</div>

<!-- Bottom Section: Cable Routing, Resilience Policies, and Node Inspector -->
<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; margin-top: 24px;">
    
    <!-- Port Cable Routing Table -->
    <div class="glass-card" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <h3 style="font-size: 1.05rem; font-weight: 700;">Port Cable Routing Table</h3>
                <span class="badge" style="background: var(--bg-primary); color: #38bdf8;">
                    @GraphExecutor.CurrentGraph.Connections.Count Cables
                </span>
            </div>
            
            <div style="max-height: 260px; overflow-y: auto;">
                <table style="width: 100%; font-size: 0.82rem; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border-color); text-align: left; color: var(--text-muted);">
                            <th style="padding: 6px;">Source</th>
                            <th style="padding: 6px;">Port</th>
                            <th style="padding: 6px;">Target</th>
                            <th style="padding: 6px; text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in GraphExecutor.CurrentGraph.Connections)
                        {
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                <td style="padding: 6px; font-weight: 600;">@c.SourceNodeId</td>
                                <td style="padding: 6px; color: @(c.SourcePort == PortType.Failure ? "#ef4444" : "#38bdf8");">
                                    @(c.SourcePort == PortType.Failure ? "🔴 Fail" : "🔵 Out")
                                </td>
                                <td style="padding: 6px; font-weight: 600;">@c.TargetNodeId</td>
                                <td style="padding: 6px; text-align: right;">
                                    <button class="btn btn-danger" style="padding: 1px 6px; font-size: 0.7rem;" title="Disconnect cable" @onclick="() => Disconnect(c)">
                                        ✕
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Circuit Breaker & Resilience Policies (Editable) -->
    <div class="glass-card">
        <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 12px;">Circuit Breaker & Resilience Policies</h3>
        
        <div class="form-group">
            <label class="form-label">Max Remediation Retries Before Circuit Trip</label>
            <input class="form-control" type="number" min="1" max="10" value="@GraphExecutor.CurrentGraph.Policy.MaxRetries" @onchange="HandleMaxRetriesChanged" />
            <span style="font-size: 0.75rem; color: var(--text-muted);">Trips and halts graph if remediation retries exceed this limit.</span>
        </div>

        <div class="form-group">
            <label class="form-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <input type="checkbox" checked="@GraphExecutor.CurrentGraph.Policy.CircuitBreakerEnabled" @onchange="HandleCircuitBreakerToggle" />
                <span>Circuit Breaker Active</span>
            </label>
            <span style="font-size: 0.75rem; color: var(--text-muted); display: block;">Automatically pauses runaway loops when rejections occur repeatedly.</span>
        </div>

        <div class="form-group">
            <label class="form-label">Fallback Remediation Handler</label>
            <select class="form-control" value="@GraphExecutor.CurrentGraph.Policy.FallbackRole" @onchange="HandleFallbackRoleChanged">
                @foreach (AgentRole role in Enum.GetValues(typeof(AgentRole)))
                {
                    <option value="@role">@role.ToEmoji() @role.ToDisplayName()</option>
                }
            </select>
            <span style="font-size: 0.75rem; color: var(--text-muted);">Agent role assigned to handle exhausted remediation failures.</span>
        </div>
    </div>

    <!-- Selected Node Inspector Panel -->
    <div class="glass-card">
        <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 12px;">Node Inspector</h3>
        
        @if (_selectedNode != null)
        {
            <div style="display: flex; flex-direction: column; gap: 10px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="font-size: 1.6rem;">@_selectedNode.Role.ToEmoji()</span>
                        <div>
                            <div style="font-weight: 700; font-size: 0.95rem; color: #fff;">@_selectedNode.Name</div>
                            <div style="font-size: 0.75rem; color: var(--text-muted); font-family: monospace;">@_selectedNode.Id</div>
                        </div>
                    </div>
                    <button class="btn btn-danger" style="padding: 2px 6px; font-size: 0.75rem;" title="Delete node from canvas" @onclick="() => DeleteNode(_selectedNode.Id)">
                        🗑️ Delete
                    </button>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 0.8rem; background: var(--bg-primary); padding: 8px; border-radius: 6px;">
                    <div>
                        <span style="color: var(--text-muted);">State:</span>
                        <div style="font-weight: 600; color: #38bdf8;">@_selectedNode.State</div>
                    </div>
                    <div>
                        <span style="color: var(--text-muted);">Retry Count:</span>
                        <div style="font-weight: 600; color: #ef4444;">@_selectedNode.RetryCount</div>
                    </div>
                    <div>
                        <span style="color: var(--text-muted);">Position:</span>
                        <div style="font-weight: 600;">(@_selectedNode.X, @_selectedNode.Y)</div>
                    </div>
                    <div>
                        <span style="color: var(--text-muted);">Ticket ID:</span>
                        <div style="font-weight: 600; font-family: monospace;">@(_selectedNode.CurrentTicketId ?? "None")</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_selectedNode.LastOutputSummary))
                {
                    <div style="font-size: 0.78rem; background: rgba(56, 189, 248, 0.08); border: 1px solid rgba(56, 189, 248, 0.2); padding: 8px; border-radius: 6px;">
                        <div style="font-weight: 600; color: #38bdf8; margin-bottom: 2px;">Last Output Deliverable:</div>
                        <div style="color: var(--text-main);">@_selectedNode.LastOutputSummary</div>
                    </div>
                }

                <div style="font-size: 0.75rem; color: var(--text-muted);">
                    <strong>Cables:</strong> 
                    @{
                        var inCount = GraphExecutor.CurrentGraph.Connections.Count(c => c.TargetNodeId == _selectedNode.Id);
                        var outCount = GraphExecutor.CurrentGraph.Connections.Count(c => c.SourceNodeId == _selectedNode.Id);
                    }
                    @inCount inbound, @outCount outbound
                </div>
            </div>
        }
        else
        {
            <div style="text-align: center; color: var(--text-muted); padding: 30px 10px;">
                <div style="font-size: 2rem; margin-bottom: 8px;">🖱️</div>
                <div style="font-size: 0.88rem;">Click on any node on the canvas to inspect its configuration and state.</div>
            </div>
        }
    </div>
</div>

<!-- Add Node Modal -->
@if (_showAddNodeModal)
{
    <div class="modal-backdrop">
        <div class="modal-dialog">
            <div class="modal-header">
                <h3 style="font-size: 1.1rem; font-weight: 700;">➕ Add Agent Node to Workflow Canvas</h3>
                <button class="btn btn-secondary" style="padding: 2px 8px;" @onclick="() => _showAddNodeModal = false">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Agent Role</label>
                    <select class="form-control" @bind="_newNodeRole">
                        @foreach (AgentRole role in Enum.GetValues(typeof(AgentRole)))
                        {
                            <option value="@role">@role.ToEmoji() @role.ToDisplayName()</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Node Display Name</label>
                    <input class="form-control" @bind="_newNodeName" placeholder="e.g. Security Reviewer Node" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => _showAddNodeModal = false">Cancel</button>
                <button class="btn btn-primary" @onclick="AddCustomNode">Add Node</button>
            </div>
        </div>
    </div>
}

<!-- Export / Import JSON Modal -->
@if (_showJsonModal)
{
    <div class="modal-backdrop">
        <div class="modal-dialog" style="max-width: 750px;">
            <div class="modal-header">
                <h3 style="font-size: 1.1rem; font-weight: 700;">
                    @(_isImportMode ? "📥 Import Workflow Graph JSON" : "💾 Export Workflow Graph JSON")
                </h3>
                <button class="btn btn-secondary" style="padding: 2px 8px;" @onclick="() => _showJsonModal = false">✕</button>
            </div>
            <div class="modal-body">
                @if (_isImportMode)
                {
                    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px;">
                        Paste a valid JSON representation of a <code>WorkflowGraph</code> below:
                    </p>
                    <textarea class="form-control" style="height: 260px; font-family: monospace; font-size: 0.8rem;" @bind="_jsonPayload" placeholder="{ &quot;Id&quot;: &quot;...&quot;, &quot;Nodes&quot;: [...] }"></textarea>
                }
                else
                {
                    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px;">
                        Copy the current graph layout & connection configuration:
                    </p>
                    <textarea class="form-control" style="height: 260px; font-family: monospace; font-size: 0.8rem;" readonly>@_jsonPayload</textarea>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => _showJsonModal = false">Close</button>
                @if (_isImportMode)
                {
                    <button class="btn btn-success" @onclick="ApplyJsonImport">Import & Apply Graph</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private string? _selectedNodeId;
    private GraphNode? _selectedNode => GraphExecutor.CurrentGraph.Nodes.FirstOrDefault(n => n.Id == _selectedNodeId);

    // Node Dragging State
    private string? _draggingNodeId;
    private double _dragStartClientX;
    private double _dragStartClientY;
    private int _nodeInitialX;
    private int _nodeInitialY;

    // Port Cabling State
    private bool _isConnecting;
    private string? _sourceConnectingNodeId;
    private PortType _sourceConnectingPort;
    private GraphNode? _sourceConnectingNode => GraphExecutor.CurrentGraph.Nodes.FirstOrDefault(n => n.Id == _sourceConnectingNodeId);
    private int _draftStartX;
    private int _draftStartY;
    private int _currentMouseX;
    private int _currentMouseY;

    // UI Feedback
    private string? _errorMessage;
    private string? _successMessage;

    // Modals
    private bool _showAddNodeModal;
    private AgentRole _newNodeRole = AgentRole.SoftwareDeveloper;
    private string _newNodeName = "";

    private bool _showJsonModal;
    private bool _isImportMode;
    private string _jsonPayload = "";

    protected override void OnInitialized()
    {
        GraphExecutor.OnGraphUpdated += HandleGraphUpdated;
        GraphExecutor.OnNodeStateChanged += HandleNodeStateChanged;
    }

    private void HandleGraphUpdated(WorkflowGraph _) => InvokeAsync(StateHasChanged);
    private void HandleNodeStateChanged(string _, NodeExecutionState __) => InvokeAsync(StateHasChanged);

    private void SelectNode(string nodeId)
    {
        _selectedNodeId = nodeId;
    }

    private void StartDrag(MouseEventArgs e, string nodeId)
    {
        var node = GraphExecutor.CurrentGraph.Nodes.FirstOrDefault(n => n.Id == nodeId);
        if (node == null) return;

        _selectedNodeId = nodeId;
        _draggingNodeId = nodeId;
        _dragStartClientX = e.ClientX;
        _dragStartClientY = e.ClientY;
        _nodeInitialX = node.X;
        _nodeInitialY = node.Y;
    }

    private void HandleCanvasMouseMove(MouseEventArgs e)
    {
        if (_isConnecting)
        {
            _currentMouseX = (int)Math.Clamp(e.OffsetX, 10, 1100);
            _currentMouseY = (int)Math.Clamp(e.OffsetY, 10, 500);
        }

        if (_draggingNodeId != null)
        {
            var deltaX = (int)(e.ClientX - _dragStartClientX);
            var deltaY = (int)(e.ClientY - _dragStartClientY);
            var newX = Math.Clamp(_nodeInitialX + deltaX, 20, 950);
            var newY = Math.Clamp(_nodeInitialY + deltaY, 20, 420);
            GraphExecutor.UpdateNodePosition(_draggingNodeId, newX, newY);
        }
    }

    private void HandleCanvasMouseUp()
    {
        _draggingNodeId = null;
    }

    private void StartConnecting(string nodeId, PortType port)
    {
        var node = GraphExecutor.CurrentGraph.Nodes.FirstOrDefault(n => n.Id == nodeId);
        if (node == null) return;

        _isConnecting = true;
        _sourceConnectingNodeId = nodeId;
        _sourceConnectingPort = port;

        _draftStartX = port == PortType.Failure ? node.X + 80 : node.X + 160;
        _draftStartY = port == PortType.Failure ? node.Y + 90 : node.Y + 45;
        _currentMouseX = _draftStartX;
        _currentMouseY = _draftStartY;
        _errorMessage = null;
    }

    private void HandleInputPortClick(string targetNodeId)
    {
        if (!_isConnecting || string.IsNullOrEmpty(_sourceConnectingNodeId))
        {
            return;
        }

        var connection = new PortConnection(_sourceConnectingNodeId, _sourceConnectingPort, targetNodeId, PortType.Input);
        if (GraphExecutor.ValidateConnection(connection, out var err))
        {
            GraphExecutor.AddConnection(connection);
            _successMessage = $"Connected {_sourceConnectingNodeId} ({_sourceConnectingPort}) to {targetNodeId} (Input)!";
            _errorMessage = null;
        }
        else
        {
            _errorMessage = err;
        }

        CancelConnecting();
    }

    private void CancelConnecting()
    {
        _isConnecting = false;
        _sourceConnectingNodeId = null;
    }

    private void Disconnect(PortConnection conn)
    {
        GraphExecutor.RemoveConnection(conn.SourceNodeId, conn.SourcePort, conn.TargetNodeId, conn.TargetPort);
        _successMessage = $"Disconnected cable: {conn.SourceNodeId} -> {conn.TargetNodeId}.";
    }

    private void DeleteNode(string nodeId)
    {
        GraphExecutor.RemoveNode(nodeId);
        if (_selectedNodeId == nodeId)
        {
            _selectedNodeId = null;
        }
        _successMessage = $"Removed node {nodeId} and all attached cables.";
    }

    private void HandleMaxRetriesChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var retries) && retries >= 1 && retries <= 20)
        {
            var policy = GraphExecutor.CurrentGraph.Policy;
            GraphExecutor.UpdatePolicy(policy with { MaxRetries = retries });
            _successMessage = $"Updated resilience policy: Max Retries = {retries}.";
        }
    }

    private void HandleCircuitBreakerToggle(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out var enabled))
        {
            var policy = GraphExecutor.CurrentGraph.Policy;
            GraphExecutor.UpdatePolicy(policy with { CircuitBreakerEnabled = enabled });
            _successMessage = $"Circuit Breaker {(enabled ? "Enabled" : "Disabled")}.";
        }
    }

    private void HandleFallbackRoleChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<AgentRole>(e.Value?.ToString(), out var role))
        {
            var policy = GraphExecutor.CurrentGraph.Policy;
            GraphExecutor.UpdatePolicy(policy with { FallbackRole = role });
            _successMessage = $"Updated Fallback Role to {role.ToDisplayName()}.";
        }
    }

    private void OnPresetSelected(ChangeEventArgs e)
    {
        var preset = e.Value?.ToString();
        if (!string.IsNullOrEmpty(preset))
        {
            GraphExecutor.LoadPreset(preset);
            _selectedNodeId = null;
            _successMessage = $"Loaded topology preset: {preset}.";
        }
    }

    private void ResetCanvas()
    {
        GraphExecutor.ResetGraph();
        _selectedNodeId = null;
        _successMessage = "Workflow graph reset to clean idle state.";
    }

    private void OpenAddNodeModal()
    {
        _newNodeRole = AgentRole.SoftwareDeveloper;
        _newNodeName = "New Engineer Node";
        _showAddNodeModal = true;
    }

    private void AddCustomNode()
    {
        var id = $"node-{Guid.NewGuid().ToString("N")[..6]}";
        var node = new GraphNode(
            Id: id,
            Role: _newNodeRole,
            Name: string.IsNullOrWhiteSpace(_newNodeName) ? _newNodeRole.ToDisplayName() : _newNodeName,
            X: 100 + (GraphExecutor.CurrentGraph.Nodes.Count * 40) % 700,
            Y: 100 + (GraphExecutor.CurrentGraph.Nodes.Count * 30) % 300
        );

        GraphExecutor.AddNode(node);
        _showAddNodeModal = false;
        _selectedNodeId = id;
        _successMessage = $"Added node '{node.Name}' ({node.Role.ToDisplayName()}) to canvas.";
    }

    private void OpenExportModal()
    {
        _isImportMode = false;
        _jsonPayload = System.Text.Json.JsonSerializer.Serialize(GraphExecutor.CurrentGraph, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        _showJsonModal = true;
    }

    private void OpenImportModal()
    {
        _isImportMode = true;
        _jsonPayload = "";
        _showJsonModal = true;
    }

    private void ApplyJsonImport()
    {
        try
        {
            var imported = System.Text.Json.JsonSerializer.Deserialize<WorkflowGraph>(_jsonPayload);
            if (imported != null && imported.Nodes.Count > 0)
            {
                GraphExecutor.SetGraph(imported);
                _showJsonModal = false;
                _selectedNodeId = null;
                _successMessage = $"Successfully imported graph with {imported.Nodes.Count} nodes and {imported.Connections.Count} connections.";
                _errorMessage = null;
            }
            else
            {
                _errorMessage = "Imported JSON did not contain valid nodes.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to parse Workflow Graph JSON: {ex.Message}";
        }
    }

    private async Task RunWorkflow(bool triggerFailure = false)
    {
        _errorMessage = null;
        _successMessage = $"Workflow execution running (Failure Simulation: {(triggerFailure ? "ON" : "OFF")})...";
        var readyTickets = TicketStore.GetReadyTickets().Where(t => t.Type != TicketType.Epic && t.Status != TicketStatus.Done).ToList();
        if (readyTickets.Count > 0 && !triggerFailure)
        {
            await GraphExecutor.ExecuteReadyTicketsAsync();
        }
        else
        {
            await GraphExecutor.ExecuteWorkflowAsync(
                "Visual DAG Workflow Execution",
                "Execute end-to-end multi-agent engineering workflow directly from interactive DAG canvas.",
                triggerFailureSimulation: triggerFailure
            );
        }
        _successMessage = "Workflow execution completed!";
    }

    private async Task StepNext()
    {
        var stepped = await GraphExecutor.StepNextNodeAsync();
        if (stepped)
        {
            _successMessage = "Stepped next agent node in DAG queue.";
        }
        else
        {
            _errorMessage = "No ready tickets or pending agent tasks found in queue.";
        }
    }

    public void Dispose()
    {
        GraphExecutor.OnGraphUpdated -= HandleGraphUpdated;
        GraphExecutor.OnNodeStateChanged -= HandleNodeStateChanged;
    }
}
