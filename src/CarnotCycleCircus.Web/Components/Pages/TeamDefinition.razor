@page "/"
@implements IDisposable
@inject ITeamDefinitionManager TeamManager
@inject IApiKeyVaultService KeyVaultService
@inject ISkillRegistry SkillRegistry
@inject IAgentNameGenerator NameGenerator
@inject IModelCatalogService CatalogService

<QuickstartRingmasterBanner />

<div class="page-header">
    <div>
        <h2 style="font-size: 1.5rem; font-weight: 700;">🎯 Team Circus Ring & Agent Studio</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Assemble your troupe of over-confident autonomous agents. Choose their LLM models, assign specialized skills, and fine-tune system directives.</p>
    </div>

    <!-- Archetype Selector & Actions -->
    <div class="page-header-actions">
        <button class="btn btn-success" @onclick="OpenAddModal" style="white-space: nowrap;">
            ➕ Add Circus Agent
        </button>

        <select class="form-control" style="width: auto; min-width: 220px; max-width: 100%;" value="@selectedArchetype" @onchange="OnArchetypeSelected">
            <option value="">-- Load Squad Archetype --</option>
            @foreach (var arc in TeamArchetypes.AllArchetypes)
            {
                <option value="@arc.ArchetypeName">@arc.Name</option>
            }
        </select>

        <button class="btn btn-secondary" @onclick="ExportTeam" style="white-space: nowrap;">💾 Export Squad JSON</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div style="padding: 10px 14px; border-radius: 8px; margin-bottom: 20px; background: rgba(56, 189, 248, 0.15); border: 1px solid #38bdf8; color: #38bdf8; font-size: 0.88rem; display: flex; justify-content: space-between; align-items: center;">
        <span>@statusMessage</span>
        <button style="background: transparent; border: none; color: #38bdf8; cursor: pointer; font-weight: bold;" @onclick="() => statusMessage = null">✕</button>
    </div>
}

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 20px;">
    @foreach (var member in currentTeam.Members)
    {
        <div @key="@member.Id" class="glass-card" style="border-top: 4px solid @member.Persona.Role.ToColorHex(); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span style="font-size: 2rem;">@member.Persona.Role.ToEmoji()</span>
                        <div>
                            <h3 style="font-size: 1.05rem; font-weight: 700; color: #f8fafc; margin-bottom: 2px;">@member.Persona.Name</h3>
                            <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
                                <span class="badge" style="background: @member.Persona.Role.ToColorHex(); color: #000; font-size: 0.68rem; font-weight: 700;">@member.Persona.Role.ToDisplayName()</span>
                                <span style="font-size: 0.7rem; color: var(--text-muted); font-family: monospace;">@member.Id</span>
                            </div>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <label style="display: flex; align-items: center; gap: 4px; font-size: 0.8rem; color: var(--text-muted); cursor: pointer;" title="Toggle Agent Active State">
                            <input type="checkbox" checked="@member.IsEnabled" @onchange="(e) => ToggleMember(member, e)" />
                            Active
                        </label>
                        <button class="btn btn-danger" style="padding: 2px 6px; font-size: 0.75rem;" title="Remove Agent from Troupe" @onclick="() => RemoveAgent(member)">
                            🗑️
                        </button>
                    </div>
                </div>

                <!-- Assigned Skills Badges -->
                @{
                    var memberSkills = GetMemberSkills(member);
                }
                @if (memberSkills.Count > 0)
                {
                    <div style="margin-bottom: 12px; background: var(--bg-primary); padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                        <div style="font-size: 0.72rem; font-weight: 600; color: var(--text-muted); margin-bottom: 4px;">Assigned Capabilities & Skills:</div>
                        <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                            @foreach (var sk in memberSkills)
                            {
                                <span class="badge" style="background: rgba(56, 189, 248, 0.12); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); font-size: 0.68rem;">
                                    🧩 @sk.Name
                                </span>
                            }
                        </div>
                    </div>
                }

                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                        <label class="form-label" style="margin-bottom: 0;">Inference Model (OpenRouter)</label>
                        <a href="models" style="font-size: 0.72rem; color: #38bdf8; text-decoration: none;" title="Manage Models and Favorites">🎭 Catalog &amp; Favorites</a>
                    </div>
                    <select class="form-control" value="@member.EffectiveModel" @onchange="(e) => UpdateModel(member, e)">
                        @{
                            var memberRole = member.Persona.Role;
                            var favorites = availableCatalogModels.Where(m => m.IsFavorite).ToList();
                            var recommended = availableCatalogModels.Where(m => !m.IsFavorite && IsRecommendedForRole(m, memberRole)).ToList();
                            var others = availableCatalogModels.Where(m => !m.IsFavorite && !IsRecommendedForRole(m, memberRole)).ToList();
                        }
                        @if (favorites.Count > 0)
                        {
                            <optgroup label="⭐ Starred Favorites">
                                @foreach (var m in favorites)
                                {
                                    <option value="@m.Id">@m.Name (@m.FormattedPricing)</option>
                                }
                            </optgroup>
                        }
                        @if (recommended.Count > 0)
                        {
                            <optgroup label="🎪 Recommended for @memberRole.ToDisplayName()">
                                @foreach (var m in recommended)
                                {
                                    <option value="@m.Id">@m.Name (@m.FormattedPricing)</option>
                                }
                            </optgroup>
                        }
                        @if (others.Count > 0)
                        {
                            <optgroup label="🌐 Other Available Models">
                                @foreach (var m in others)
                                {
                                    <option value="@m.Id">@m.Name (@m.FormattedPricing)</option>
                                }
                            </optgroup>
                        }
                    </select>
                    @{
                        var currentSelectedModel = availableCatalogModels.FirstOrDefault(m => m.Id == member.EffectiveModel);
                    }
                    @if (currentSelectedModel != null)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 4px; font-size: 0.7rem; color: var(--text-muted);">
                            <span>💰 @currentSelectedModel.FormattedPricing</span>
                            <span>📏 @(currentSelectedModel.ContextLength / 1000)k ctx</span>
                        </div>
                    }
                </div>

                <div class="form-group">
                    <label class="form-label">Custom API Key Override</label>
                    <select class="form-control" value="@(member.CustomApiKeyId ?? "")" @onchange="(e) => UpdateKey(member, e)">
                        <option value="">Use Team Global Key (Fallback)</option>
                        @foreach (var key in KeyVaultService.GetAllKeys())
                        {
                            <option value="@key.KeyId">@key.KeyName (@key.ApiKeyMasked)</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Role Directive & System Prompt</label>
                    <textarea class="form-control" rows="3" style="font-size: 0.8rem;" value="@member.Persona.SystemPrompt" @onchange="(e) => UpdatePrompt(member, e)"></textarea>
                </div>

                <div>
                    <div style="font-size: 0.78rem; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">Allowed Sandboxed Tools:</div>
                    <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                        @foreach (var tool in member.Persona.AllowedToolNames)
                        {
                            <span style="font-family: monospace; font-size: 0.72rem; background: var(--bg-primary); border: 1px solid var(--border-color); padding: 2px 6px; border-radius: 4px; color: #38bdf8;">
                                ⚙️ @tool
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (currentTeam.Members.Count == 0)
{
    <div class="glass-card" style="text-align: center; color: var(--text-muted); padding: 40px; margin-top: 20px;">
        <span style="font-size: 2rem;">🎪</span>
        <h3 style="font-size: 1.1rem; font-weight: 700; color: #f8fafc; margin-top: 10px;">Your circus ring is currently empty!</h3>
        <p style="font-size: 0.85rem; margin-bottom: 16px;">Click "Add Circus Agent" above to enlist performers into your engineering troupe.</p>
        <button class="btn btn-success" @onclick="OpenAddModal">➕ Enlist First Agent</button>
    </div>
}

<!-- Add Circus Agent Modal -->
@if (showAddModal)
{
    <div class="modal-backdrop" @onclick="() => showAddModal = false">
        <div class="modal-dialog" style="max-width: 680px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 1.3rem;">🎪</span>
                    <h3 style="font-size: 1.15rem; font-weight: 700;">Enlist New Circus Agent</h3>
                </div>
                <button class="btn btn-secondary" @onclick="() => showAddModal = false" style="padding: 4px 8px;">✕</button>
            </div>

            <div class="modal-body" style="max-height: 75vh; overflow-y: auto;">
                <!-- Role Selection -->
                <div class="form-group">
                    <label class="form-label">1. Select Circus Role</label>
                    <select class="form-control" value="@newAgentRole" @onchange="OnRoleChanged">
                        @foreach (var role in Enum.GetValues<AgentRole>())
                        {
                            <option value="@role">@role.ToEmoji() @role.ToDisplayName()</option>
                        }
                    </select>
                </div>

                <!-- Skill Assignment at Creation Time -->
                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <label class="form-label" style="margin-bottom: 0;">2. Assign Specialized Skills at Creation Time</label>
                        <span style="font-size: 0.75rem; color: #38bdf8;">(@selectedSkillIds.Count skills selected)</span>
                    </div>
                    <p style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 8px;">
                        Selected capabilities are incorporated into the suggested name, carnival archetype, and cognitive system prompt directives.
                    </p>
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 8px; background: var(--bg-primary); padding: 12px; border-radius: 8px; border: 1px solid var(--border-color); max-height: 180px; overflow-y: auto;">
                        @foreach (var skill in SkillRegistry.GetAllSkills())
                        {
                            var isChecked = selectedSkillIds.Contains(skill.Id);
                            <label style="display: flex; align-items: flex-start; gap: 8px; font-size: 0.8rem; cursor: pointer; color: #f8fafc; padding: 4px 6px; border-radius: 4px; background: @(isChecked ? "rgba(56, 189, 248, 0.1)" : "transparent");">
                                <input type="checkbox" checked="@isChecked" @onchange="(e) => ToggleSkillSelection(skill.Id, e)" style="margin-top: 3px;" />
                                <div>
                                    <div style="font-weight: 600; color: @(isChecked ? "#38bdf8" : "#f8fafc");">@skill.Name</div>
                                    <div style="font-size: 0.7rem; color: var(--text-muted);">@skill.Category • @skill.Id</div>
                                </div>
                            </label>
                        }
                    </div>
                </div>

                <!-- Suggested Name with Reroll and Suggestions -->
                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <label class="form-label" style="margin-bottom: 0;">3. Absurd Agent Name (Skill-Infused)</label>
                        <button type="button" class="btn btn-secondary" style="padding: 2px 8px; font-size: 0.75rem;" @onclick="RerollSuggestedName">
                            🎲 Reroll Suggestions
                        </button>
                    </div>
                    <input class="form-control" @bind="newAgentName" placeholder="e.g. Archduke Percival 'Zero-Alloc' Byte-Trapeze (Senior Developer)" />
                    
                    <!-- Name Suggestion Chips -->
                    @if (nameSuggestions.Count > 0)
                    {
                        <div style="margin-top: 8px;">
                            <div style="font-size: 0.72rem; color: var(--text-muted); margin-bottom: 4px;">Click a suggested alternative:</div>
                            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                                @foreach (var sug in nameSuggestions)
                                {
                                    <button type="button" class="btn btn-secondary" style="padding: 3px 8px; font-size: 0.74rem; background: var(--bg-tertiary); border: 1px solid var(--border-color);" @onclick="() => SelectSuggestion(sug)">
                                        ✨ @sug
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Inference Model and Temperature -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div class="form-group">
                        <label class="form-label">Primary OpenRouter Model</label>
                        <select class="form-control" @bind="newAgentModel">
                            @{
                                var favs = availableCatalogModels.Where(m => m.IsFavorite).ToList();
                                var recs = availableCatalogModels.Where(m => !m.IsFavorite && IsRecommendedForRole(m, newAgentRole)).ToList();
                                var others = availableCatalogModels.Where(m => !m.IsFavorite && !IsRecommendedForRole(m, newAgentRole)).ToList();
                            }
                            @if (favs.Count > 0)
                            {
                                <optgroup label="⭐ Starred Favorites">
                                    @foreach (var m in favs)
                                    {
                                        <option value="@m.Id">@m.Name (@m.FormattedPricing)</option>
                                    }
                                </optgroup>
                            }
                            @if (recs.Count > 0)
                            {
                                <optgroup label="🎪 Recommended for @newAgentRole.ToDisplayName()">
                                    @foreach (var m in recs)
                                    {
                                        <option value="@m.Id">@m.Name (@m.FormattedPricing)</option>
                                    }
                                </optgroup>
                            }
                            @if (others.Count > 0)
                            {
                                <optgroup label="🌐 Other Available Models">
                                    @foreach (var m in others)
                                    {
                                        <option value="@m.Id">@m.Name (@m.FormattedPricing)</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Fallback Model</label>
                        <select class="form-control" @bind="newAgentFallbackModel">
                            @{
                                var fallbackFavs = availableCatalogModels.Where(m => m.IsFavorite).ToList();
                                var fallbackFast = availableCatalogModels.Where(m => !m.IsFavorite && (m.StrengthAreas.Contains(ModelStrengthArea.LowLatencyFallback) || m.CostTier == ModelCostTier.Budget)).ToList();
                                var fallbackOthers = availableCatalogModels.Where(m => !m.IsFavorite && !fallbackFast.Contains(m)).ToList();
                            }
                            @if (fallbackFavs.Count > 0)
                            {
                                <optgroup label="⭐ Starred Favorites">
                                    @foreach (var m in fallbackFavs)
                                    {
                                        <option value="@m.Id">@m.Name (@m.FormattedPricing)</option>
                                    }
                                </optgroup>
                            }
                            @if (fallbackFast.Count > 0)
                            {
                                <optgroup label="⚡ Fast & Budget Fallbacks">
                                    @foreach (var m in fallbackFast)
                                    {
                                        <option value="@m.Id">@m.Name (@m.FormattedPricing)</option>
                                    }
                                </optgroup>
                            }
                            @if (fallbackOthers.Count > 0)
                            {
                                <optgroup label="🌐 Other Models">
                                    @foreach (var m in fallbackOthers)
                                    {
                                        <option value="@m.Id">@m.Name (@m.FormattedPricing)</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                </div>

                <!-- Allowed Sandboxed Tools -->
                <div class="form-group">
                    <label class="form-label">Allowed Sandboxed Tools (Comma-separated)</label>
                    <input class="form-control" @bind="newAgentTools" placeholder="csharp_syntax_check, web_search, test_runner..." />
                </div>

                <!-- Role Directive & System Prompt -->
                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <label class="form-label" style="margin-bottom: 0;">Role Directive & System Prompt</label>
                        <button type="button" class="btn btn-secondary" style="padding: 2px 8px; font-size: 0.75rem;" @onclick="RegenerateSystemPrompt">
                            🔄 Reset Prompt from Skills
                        </button>
                    </div>
                    <textarea class="form-control" rows="4" style="font-size: 0.8rem; font-family: monospace;" @bind="newAgentSystemPrompt"></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showAddModal = false">Cancel</button>
                <button class="btn btn-success" @onclick="CreateAndAddAgent">🎪 Enlist Agent into Troupe</button>
            </div>
        </div>
    </div>
}

@if (showExportModal)
{
    <div class="modal-backdrop" @onclick="() => showExportModal = false">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 style="font-size: 1.1rem; font-weight: 700;">Team Configuration Manifest (JSON)</h3>
                <button class="btn btn-secondary" @onclick="() => showExportModal = false" style="padding: 4px 8px;">✕</button>
            </div>
            <div class="modal-body">
                <pre style="background: var(--bg-primary); padding: 14px; border-radius: 8px; font-size: 0.8rem; overflow-x: auto; max-height: 400px; font-family: monospace;">@exportedJson</pre>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showExportModal = false">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private EngineeringTeam currentTeam = default!;
    private string? statusMessage;
    private string selectedArchetype = "";
    private bool showExportModal;
    private string exportedJson = "";

    // Add Agent Modal State
    private bool showAddModal;
    private AgentRole newAgentRole = AgentRole.SoftwareDeveloper;
    private HashSet<string> selectedSkillIds = new();
    private string newAgentName = "";
    private List<string> nameSuggestions = new();
    private string newAgentModel = "qwen/qwen-2.5-coder-32b-instruct";
    private string newAgentFallbackModel = "anthropic/claude-3.7-sonnet";
    private double newAgentTemperature = 0.1;
    private string newAgentTools = "csharp_syntax_check, test_runner, memory_lookup";
    private string newAgentSystemPrompt = "";
    private IReadOnlyList<ModelCatalogEntry> availableCatalogModels = [];

    protected override async Task OnInitializedAsync()
    {
        currentTeam = TeamManager.GetCurrentTeam();
        TeamManager.OnCurrentTeamChanged += HandleTeamChanged;
        availableCatalogModels = await CatalogService.GetModelsAsync();
    }

    private static bool IsRecommendedForRole(ModelCatalogEntry model, AgentRole role) => role switch
    {
        AgentRole.TechnicalProductManager => model.StrengthAreas.Contains(ModelStrengthArea.GeneralOrchestration),
        AgentRole.LeadArchitect => model.StrengthAreas.Contains(ModelStrengthArea.DeepReasoning) || model.StrengthAreas.Contains(ModelStrengthArea.GeneralOrchestration),
        AgentRole.SoftwareDeveloper => model.StrengthAreas.Contains(ModelStrengthArea.CodeGeneration),
        AgentRole.SecurityEngineer => model.StrengthAreas.Contains(ModelStrengthArea.SecurityAudit) || model.StrengthAreas.Contains(ModelStrengthArea.DeepReasoning),
        AgentRole.OptimizationEngineer => model.StrengthAreas.Contains(ModelStrengthArea.CodeGeneration) || model.StrengthAreas.Contains(ModelStrengthArea.DeepReasoning),
        AgentRole.PrincipalQAAnalyst => model.StrengthAreas.Contains(ModelStrengthArea.DeepReasoning) || model.StrengthAreas.Contains(ModelStrengthArea.CodeGeneration),
        _ => true
    };

    private void HandleTeamChanged(EngineeringTeam team)
    {
        currentTeam = team;
        InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<SkillDefinition> GetMemberSkills(AgentMember member)
    {
        if (member.Persona.AssignedSkillIds.Count > 0)
        {
            return member.Persona.AssignedSkillIds
                .Select(id => SkillRegistry.GetSkill(id))
                .Where(s => s != null)
                .Cast<SkillDefinition>()
                .ToList();
        }

        return SkillRegistry.GetSkillsForRole(member.Persona.Role);
    }

    private void OnArchetypeSelected(ChangeEventArgs e)
    {
        var archetype = e.Value?.ToString();
        if (!string.IsNullOrEmpty(archetype))
        {
            selectedArchetype = archetype;
            TeamManager.LoadArchetype(archetype);
            statusMessage = $"Loaded preset archetype '{archetype}' successfully.";
        }
    }

    private void ToggleMember(AgentMember member, ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? true);
        UpdateMember(member with { IsEnabled = isChecked });
    }

    private void UpdateModel(AgentMember member, ChangeEventArgs e)
    {
        var model = e.Value?.ToString();
        UpdateMember(member with { OverrideModel = model });
    }

    private void UpdateKey(AgentMember member, ChangeEventArgs e)
    {
        var keyId = e.Value?.ToString();
        UpdateMember(member with { CustomApiKeyId = string.IsNullOrEmpty(keyId) ? null : keyId });
    }

    private void UpdatePrompt(AgentMember member, ChangeEventArgs e)
    {
        var prompt = e.Value?.ToString() ?? "";
        UpdateMember(member with { Persona = member.Persona with { SystemPrompt = prompt } });
    }

    private void UpdateMember(AgentMember updated)
    {
        TeamManager.UpdateMemberInCurrentTeam(updated);
        statusMessage = $"Updated configuration for {updated.Persona.Name}.";
    }

    private void RemoveAgent(AgentMember member)
    {
        var removed = TeamManager.RemoveMemberFromCurrentTeam(member.Id);
        if (removed)
        {
            statusMessage = $"Removed agent '{member.Persona.Name}' from the troupe.";
        }
        else
        {
            statusMessage = $"Could not remove agent '{member.Persona.Name}'.";
        }
    }

    private void OpenAddModal()
    {
        newAgentRole = AgentRole.SoftwareDeveloper;
        selectedSkillIds.Clear();

        // Default skills for the selected role
        var roleSkills = SkillRegistry.GetSkillsForRole(newAgentRole);
        foreach (var s in roleSkills)
        {
            selectedSkillIds.Add(s.Id);
        }

        UpdateRoleDefaults();
        showAddModal = true;
    }

    private void OnRoleChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<AgentRole>(e.Value?.ToString(), out var role))
        {
            newAgentRole = role;
            selectedSkillIds.Clear();
            var roleSkills = SkillRegistry.GetSkillsForRole(newAgentRole);
            foreach (var s in roleSkills)
            {
                selectedSkillIds.Add(s.Id);
            }
            UpdateRoleDefaults();
        }
    }

    private void ToggleSkillSelection(string skillId, ChangeEventArgs e)
    {
        var isChecked = (bool)(e.Value ?? true);
        if (isChecked)
        {
            selectedSkillIds.Add(skillId);
        }
        else
        {
            selectedSkillIds.Remove(skillId);
        }

        RefreshNameAndPrompt();
    }

    private void UpdateRoleDefaults()
    {
        var defaultPersona = AgentPersona.CreateDefault(newAgentRole);
        newAgentModel = defaultPersona.DefaultModel;
        newAgentFallbackModel = defaultPersona.FallbackModel;
        newAgentTemperature = defaultPersona.Temperature;

        var skills = GetSelectedSkills();
        var tools = new HashSet<string>(defaultPersona.AllowedToolNames);
        foreach (var s in skills)
        {
            foreach (var t in s.RecommendedTools) tools.Add(t);
        }
        newAgentTools = string.Join(", ", tools);

        RefreshNameAndPrompt();
    }

    private List<SkillDefinition> GetSelectedSkills()
    {
        return selectedSkillIds
            .Select(id => SkillRegistry.GetSkill(id))
            .Where(s => s != null)
            .Cast<SkillDefinition>()
            .ToList();
    }

    private void RefreshNameAndPrompt()
    {
        var skills = GetSelectedSkills();
        var suggestions = NameGenerator.GenerateNameSuggestions(newAgentRole, skills, count: 4);
        nameSuggestions = suggestions.ToList();
        newAgentName = suggestions.FirstOrDefault() ?? $"{newAgentRole.ToDisplayName()} Agent";
        newAgentSystemPrompt = NameGenerator.GenerateSystemPrompt(newAgentRole, newAgentName, skills);
    }

    private void RerollSuggestedName()
    {
        var skills = GetSelectedSkills();
        var suggestions = NameGenerator.GenerateNameSuggestions(newAgentRole, skills, count: 4);
        nameSuggestions = suggestions.ToList();
        newAgentName = suggestions.FirstOrDefault() ?? newAgentName;
        newAgentSystemPrompt = NameGenerator.GenerateSystemPrompt(newAgentRole, newAgentName, skills);
    }

    private void SelectSuggestion(string name)
    {
        newAgentName = name;
        var skills = GetSelectedSkills();
        newAgentSystemPrompt = NameGenerator.GenerateSystemPrompt(newAgentRole, newAgentName, skills);
    }

    private void RegenerateSystemPrompt()
    {
        var skills = GetSelectedSkills();
        newAgentSystemPrompt = NameGenerator.GenerateSystemPrompt(newAgentRole, newAgentName, skills);
    }

    private void CreateAndAddAgent()
    {
        if (string.IsNullOrWhiteSpace(newAgentName))
        {
            statusMessage = "Agent name cannot be empty.";
            return;
        }

        var toolsList = newAgentTools.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(t => t.Trim())
            .Where(t => !string.IsNullOrEmpty(t))
            .ToList();

        if (toolsList.Count == 0)
        {
            toolsList = ["csharp_syntax_check", "web_search", "memory_lookup"];
        }

        var persona = new AgentPersona(
            Role: newAgentRole,
            Name: newAgentName.Trim(),
            SystemPrompt: newAgentSystemPrompt.Trim(),
            DefaultModel: newAgentModel,
            FallbackModel: newAgentFallbackModel,
            Temperature: newAgentTemperature,
            AllowedToolNames: toolsList,
            AssignedSkillIds: selectedSkillIds.ToList()
        );

        var member = new AgentMember(
            Persona: persona,
            CustomApiKeyId: null,
            OverrideModel: null,
            IsEnabled: true
        );

        TeamManager.AddMemberToCurrentTeam(member);

        showAddModal = false;
        statusMessage = $"Enlisted new agent '{persona.Name}' ({persona.Role.ToDisplayName()}) into the circus troupe!";
    }

    private void ExportTeam()
    {
        exportedJson = TeamManager.ExportToJson(currentTeam.Id);
        showExportModal = true;
    }

    public void Dispose()
    {
        TeamManager.OnCurrentTeamChanged -= HandleTeamChanged;
    }
}
