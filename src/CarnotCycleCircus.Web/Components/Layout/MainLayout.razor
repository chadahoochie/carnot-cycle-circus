@inherits LayoutComponentBase
@implements IDisposable
@inject IApiKeyVaultService KeyVaultService

<div class="app-container">
    <NavMenu />

    <div class="main-content">
        <header class="top-bar">
            <div style="display: flex; align-items: center; gap: 12px;">
                <span style="font-weight: 700; color: #f8fafc; font-size: 1.1rem;">🎪 Carnot Cycle Circus</span>
                <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid #f59e0b; font-size: 0.72rem;">
                    Efficiency: η = 1 - T_cold/T_hot (99.9% Caffeine)
                </span>
            </div>

            <!-- Top Bar Quick Actions & Key Swapper -->
            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                <button class="btn btn-primary" @onclick="() => showIgnitionModal = true" style="padding: 6px 12px; font-size: 0.82rem;">
                    🚀 New Project
                </button>
                <button class="btn btn-success" @onclick="() => showHarvesterModal = true" style="padding: 6px 12px; font-size: 0.82rem;">
                    🔍 Scan Repo
                </button>
                <button class="btn btn-secondary" @onclick="() => showShowcaseModal = true" style="padding: 6px 12px; font-size: 0.82rem; color: #f59e0b; border-color: #f59e0b;">
                    🍿 30s Demo
                </button>

                @{
                    var activeKey = KeyVaultService.GetActiveKey();
                }
                <div style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; background: var(--bg-primary); padding: 6px 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                    <span style="color: #eab308;">🔑</span>
                    <span style="color: var(--text-muted);">VC Burner Key:</span>
                    <span style="font-weight: 600; color: #38bdf8;">@(activeKey?.KeyName ?? "None")</span>
                    <span style="color: var(--text-muted); font-family: monospace;">(@(activeKey?.ApiKeyMasked ?? "No Key"))</span>
                </div>

                <button class="btn btn-secondary" @onclick="() => showKeyModal = true" style="padding: 6px 12px; font-size: 0.82rem;">
                    💰 Key Vault
                </button>
            </div>
        </header>

        <main class="content-viewport">
            @Body
        </main>
    </div>
</div>

@if (showKeyModal)
{
    <KeyVaultModal OnClose="() => showKeyModal = false" />
}

@if (showIgnitionModal)
{
    <ProjectIgnitionModal OnClose="() => showIgnitionModal = false" />
}

@if (showHarvesterModal)
{
    <CodebaseHarvesterModal OnClose="() => showHarvesterModal = false" />
}

@if (showShowcaseModal)
{
    <ShowcaseModal OnClose="() => showShowcaseModal = false" />
}

@code {
    private bool showKeyModal = false;
    private bool showIgnitionModal = false;
    private bool showHarvesterModal = false;
    private bool showShowcaseModal = false;

    protected override void OnInitialized()
    {
        KeyVaultService.OnKeyUpdated += OnKeyUpdated;
    }

    private void OnKeyUpdated(ApiKeyVaultEntry entry)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        KeyVaultService.OnKeyUpdated -= OnKeyUpdated;
    }
}
