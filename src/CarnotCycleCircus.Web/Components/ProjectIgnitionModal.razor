@inject IProjectBlueprintService BlueprintService
@inject NavigationManager Navigation

<div class="modal-backdrop" @onclick="Close">
    <div class="modal-content" style="max-width: 820px; max-height: 90vh; overflow-y: auto;" @onclick:stopPropagation="true">
        <!-- Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 1.8rem;">🚀</span>
                <div>
                    <h3 style="font-size: 1.25rem; font-weight: 700; color: #f8fafc; margin-bottom: 2px;">
                        Project Ignition Wizard (From Scratch)
                    </h3>
                    <div style="font-size: 0.8rem; color: #38bdf8;">
                        Kick off a greenfield initiative with pre-decomposed Epics, DAG subtasks, ADRs, and squad blueprints.
                    </div>
                </div>
            </div>
            <button class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.9rem;" @onclick="Close">✕</button>
        </div>

        @if (generationResult != null)
        {
            <!-- Success Screen -->
            <div class="glass-card" style="border: 2px solid #22c55e; padding: 24px; text-align: center; margin-bottom: 20px;">
                <div style="font-size: 3rem; margin-bottom: 10px;">🎉</div>
                <h4 style="font-size: 1.3rem; font-weight: 700; color: #22c55e; margin-bottom: 8px;">Swarm Ignited Successfully!</h4>
                <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 16px;">
                    @generationResult.Summary
                </p>

                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px; text-align: left;">
                    <div style="background: var(--bg-primary); padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                        <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase;">Generated Epic</div>
                        <div style="font-size: 1rem; font-weight: 700; color: #38bdf8; font-family: monospace;">@generationResult.EpicId</div>
                    </div>
                    <div style="background: var(--bg-primary); padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                        <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase;">Architectural Record</div>
                        <div style="font-size: 1rem; font-weight: 700; color: #a855f7; font-family: monospace;">@generationResult.AdrId</div>
                    </div>
                    <div style="background: var(--bg-primary); padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                        <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase;">Technical Subtasks</div>
                        <div style="font-size: 1rem; font-weight: 700; color: #22c55e;">@generationResult.CreatedTickets.Count items</div>
                    </div>
                </div>

                <div style="display: flex; justify-content: center; gap: 12px;">
                    <button class="btn btn-primary" @onclick='() => NavigateTo("/tickets")'>
                        📋 Open Kanban Board
                    </button>
                    <button class="btn btn-secondary" @onclick='() => NavigateTo("/canvas")'>
                        🎨 View Workflow Canvas
                    </button>
                    <button class="btn btn-success" @onclick='() => NavigateTo("/dashboard")'>
                        ⚡ Unleash in Panic Dashboard
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Mode Switcher -->
            <div style="display: flex; gap: 10px; margin-bottom: 20px;">
                <button class="btn @(activeTab == "blueprints" ? "btn-primary" : "btn-secondary")" @onclick='() => activeTab = "blueprints"' style="flex: 1;">
                    📦 Curated Architecture Blueprints (@BlueprintService.GetAvailableBlueprints().Count)
                </button>
                <button class="btn @(activeTab == "custom" ? "btn-primary" : "btn-secondary")" @onclick='() => activeTab = "custom"' style="flex: 1;">
                    ✨ Custom Dream Objective
                </button>
            </div>

            @if (activeTab == "blueprints")
            {
                <div style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 20px;">
                    @foreach (var bp in BlueprintService.GetAvailableBlueprints())
                    {
                        var isSelected = selectedBlueprintId == bp.Id;
                        <div class="glass-card" style="border: 2px solid @(isSelected ? "#38bdf8" : "var(--border-color)"); cursor: pointer; transition: all 0.2s;" @onclick="() => selectedBlueprintId = bp.Id">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                                <div style="font-size: 1.05rem; font-weight: 700; color: #f8fafc;">
                                    @bp.Title
                                </div>
                                <span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid #38bdf8; font-size: 0.7rem;">
                                    @bp.Category
                                </span>
                            </div>

                            <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 10px; line-height: 1.4;">
                                @bp.Tagline
                            </p>

                            <div style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.75rem;">
                                <span style="background: var(--bg-primary); padding: 4px 8px; border-radius: 4px; color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);">
                                    🛠️ @bp.TargetStack
                                </span>
                                <span style="background: var(--bg-primary); padding: 4px 8px; border-radius: 4px; color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3);">
                                    🎭 Squad: @bp.RecommendedArchetype
                                </span>
                            </div>
                        </div>
                    }
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 10px;">
                    <button class="btn btn-secondary" @onclick="Close">Cancel</button>
                    <button class="btn btn-success" @onclick="IgniteSelectedBlueprint" disabled="@(isProcessing || string.IsNullOrEmpty(selectedBlueprintId))">
                        @(isProcessing ? "⏳ Deconstructing Architecture..." : "🚀 Ignite Blueprint Swarm")
                    </button>
                </div>
            }
            else
            {
                <div class="glass-card" style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 20px;">
                    <div>
                        <label style="font-size: 0.85rem; font-weight: 600; color: #38bdf8; display: block; margin-bottom: 4px;">Initiative / Product Title</label>
                        <input class="form-control" placeholder="e.g. Distributed Notification Hub with SignalR and WebPush" @bind="customTitle" />
                    </div>

                    <div>
                        <label style="font-size: 0.85rem; font-weight: 600; color: #38bdf8; display: block; margin-bottom: 4px;">Vision, Goals & Acceptance Criteria</label>
                        <textarea class="form-control" rows="3" placeholder="Describe the problem, target throughput, resiliency needs, and deliverables..." @bind="customDescription"></textarea>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div>
                            <label style="font-size: 0.85rem; font-weight: 600; color: #38bdf8; display: block; margin-bottom: 4px;">Target Tech Stack</label>
                            <input class="form-control" placeholder=".NET 10 / C# 13, Aspire, PostgreSQL, Redis" @bind="customStack" />
                        </div>
                        <div>
                            <label style="font-size: 0.85rem; font-weight: 600; color: #38bdf8; display: block; margin-bottom: 4px;">Recommended Squad Archetype</label>
                            <select class="form-control" @bind="customArchetype">
                                <option value="Balanced">🎪 The Full 6-Ring Circus (Balanced)</option>
                                <option value="HighPerformance">⚡ Zero-Allocation Zealots (Nano-Benchmarkers)</option>
                                <option value="SecurityHardened">🛡️ Paranoid Zero-Trust Bunker</option>
                                <option value="IvoryTowerCathedrals">🏛️ Ivory Tower Cathedral Builders</option>
                                <option value="ChaosMonkeyRodeo">🧪 Chaos Monkey Rodeo</option>
                                <option value="MoveFastBreakProduction">🤠 Move Fast & Break Production</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 10px;">
                    <button class="btn btn-secondary" @onclick="Close">Cancel</button>
                    <button class="btn btn-primary" @onclick="IgniteCustomProject" disabled="@(isProcessing || string.IsNullOrWhiteSpace(customTitle))">
                        @(isProcessing ? "⏳ Deconstructing Sins & Tasks..." : "🎯 Ignite Custom Swarm")
                    </button>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string activeTab = "blueprints";
    private string selectedBlueprintId = "iot-ingestion-pipeline";
    private string customTitle = "";
    private string customDescription = "";
    private string customStack = ".NET 10 / C# 13, Aspire, PostgreSQL, Channels";
    private string customArchetype = "Balanced";
    private bool isProcessing = false;
    private BlueprintGenerationResult? generationResult;

    private async Task IgniteSelectedBlueprint()
    {
        isProcessing = true;
        try
        {
            generationResult = await BlueprintService.LaunchBlueprintAsync(selectedBlueprintId);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task IgniteCustomProject()
    {
        isProcessing = true;
        try
        {
            generationResult = await BlueprintService.LaunchCustomProjectAsync(
                customTitle,
                customDescription,
                customStack,
                customArchetype
            );
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NavigateTo(string path)
    {
        Navigation.NavigateTo(path);
        await Close();
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
