@inject IProjectBlueprintService BlueprintService
@inject ITeamDefinitionManager TeamManager
@inject NavigationManager Navigation

<div class="modal-backdrop" @onclick="Close">
    <div class="modal-content" style="max-width: 820px; max-height: 90vh; overflow-y: auto;" @onclick:stopPropagation="true">
        <!-- Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 1.8rem;">🚀</span>
                <div>
                    <h3 style="font-size: 1.25rem; font-weight: 700; color: #f8fafc; margin-bottom: 2px;">
                        Project Ignition Studio (Dynamic Swarm Creation)
                    </h3>
                    <div style="font-size: 0.8rem; color: #38bdf8;">
                        Ignite a new engineering initiative with dynamic Epic decomposition, DAG subtasks, initial ADR, and squad alignment.
                    </div>
                </div>
            </div>
            <button class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.9rem;" @onclick="Close">✕</button>
        </div>

        @if (generationResult != null)
        {
            <!-- Success Screen -->
            <div class="glass-card" style="border: 2px solid #22c55e; padding: 24px; text-align: center; margin-bottom: 20px;">
                <div style="font-size: 3rem; margin-bottom: 10px;">🎉</div>
                <h4 style="font-size: 1.3rem; font-weight: 700; color: #22c55e; margin-bottom: 8px;">Swarm Ignited Successfully!</h4>
                <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 16px;">
                    @generationResult.Summary
                </p>

                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px; text-align: left;">
                    <div style="background: var(--bg-primary); padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                        <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase;">Generated Epic</div>
                        <div style="font-size: 1rem; font-weight: 700; color: #38bdf8; font-family: monospace;">@generationResult.EpicId</div>
                    </div>
                    <div style="background: var(--bg-primary); padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                        <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase;">Architectural Record</div>
                        <div style="font-size: 1rem; font-weight: 700; color: #a855f7; font-family: monospace;">@generationResult.AdrId</div>
                    </div>
                    <div style="background: var(--bg-primary); padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                        <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase;">Technical Subtasks</div>
                        <div style="font-size: 1rem; font-weight: 700; color: #22c55e;">@generationResult.CreatedTickets.Count items</div>
                    </div>
                </div>

                <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
                    <button class="btn btn-primary" @onclick='() => NavigateTo("/tickets")'>
                        📋 Open Jira Graveyard
                    </button>
                    <button class="btn btn-secondary" @onclick='() => NavigateTo("/teams")'>
                        👥 View Team Management & DAG
                    </button>
                    <button class="btn btn-success" @onclick='() => NavigateTo("/dashboard")'>
                        ⚡ Unleash in Panic Dashboard
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Quick Starter Suggestions Chips -->
            <div style="margin-bottom: 16px;">
                <div style="font-size: 0.78rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px;">
                    💡 Quick Starter Ideas (Click to populate):
                </div>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                    @foreach (var suggestion in BlueprintService.GetSuggestedInitiatives())
                    {
                        <button type="button" class="btn btn-secondary" style="font-size: 0.75rem; padding: 4px 8px; border-radius: 16px;" @onclick="() => PopulateFromSuggestion(suggestion)">
                            @suggestion.Title.Split(' ')[0] @suggestion.Title.Split(' ')[1]
                        </button>
                    }
                </div>
            </div>

            <!-- Dynamic Project Form -->
            <div class="glass-card" style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 20px;">
                <div>
                    <label style="font-size: 0.85rem; font-weight: 600; color: #38bdf8; display: block; margin-bottom: 4px;">Initiative / Product Title</label>
                    <input class="form-control" placeholder="e.g. High-Throughput Telemetry Pipeline or Distributed Order Saga" @bind="projectTitle" />
                </div>

                <div>
                    <label style="font-size: 0.85rem; font-weight: 600; color: #38bdf8; display: block; margin-bottom: 4px;">Vision, Scope & Acceptance Criteria</label>
                    <textarea class="form-control" rows="3" placeholder="Describe the domain requirements, latency SLA, resiliency expectations, and deliverables..." @bind="projectDescription"></textarea>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div>
                        <label style="font-size: 0.85rem; font-weight: 600; color: #38bdf8; display: block; margin-bottom: 4px;">Target Tech Stack</label>
                        <input class="form-control" placeholder=".NET 10 / C# 13 Clean Architecture, Channels, ValueTask" @bind="targetStack" />
                    </div>
                    <div>
                        <label style="font-size: 0.85rem; font-weight: 600; color: #38bdf8; display: block; margin-bottom: 4px;">Assigned Engineering Squad</label>
                        <select class="form-control" @bind="selectedTeamId">
                            @foreach (var team in definedTeams)
                            {
                                <option value="@team.Id">
                                    @(team.Id == currentActiveTeamId ? "⭐ (Active) " : "")@team.Name
                                </option>
                            }
                        </select>
                        <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 3px;">
                            Defined team models, DAG graphs, and API keys are preserved.
                        </div>
                    </div>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button class="btn btn-secondary" @onclick="Close">Cancel</button>
                <button class="btn btn-primary" @onclick="IgniteProject" disabled="@(isProcessing || string.IsNullOrWhiteSpace(projectTitle))">
                    @(isProcessing ? "⏳ Deconstructing Architecture & Backlog..." : "🎯 Ignite Autonomous Swarm")
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string projectTitle = "";
    private string projectDescription = "";
    private string targetStack = ".NET 10 / C# 13 Clean Architecture, Channels, ValueTask";
    private string selectedTeamId = "";
    private string currentActiveTeamId = "";
    private IReadOnlyList<TeamDefinition> definedTeams = [];
    private bool isProcessing = false;
    private BlueprintGenerationResult? generationResult;

    protected override void OnInitialized()
    {
        definedTeams = TeamManager.GetAllTeams();
        var current = TeamManager.GetCurrentTeam();
        currentActiveTeamId = current.Id;
        selectedTeamId = current.Id;
    }

    private void PopulateFromSuggestion(ProjectBlueprint suggestion)
    {
        projectTitle = suggestion.EpicTitle;
        projectDescription = suggestion.EpicDescription;
        targetStack = suggestion.TargetStack;

        var matchingTeam = definedTeams.FirstOrDefault(t => t.Id == suggestion.RecommendedTeamId);
        if (matchingTeam != null)
        {
            selectedTeamId = matchingTeam.Id;
        }
    }

    private async Task IgniteProject()
    {
        if (string.IsNullOrWhiteSpace(projectTitle)) return;
        isProcessing = true;
        try
        {
            generationResult = await BlueprintService.LaunchProjectAsync(new ProjectIgnitionRequest(
                Title: projectTitle,
                Description: projectDescription,
                TargetStack: targetStack,
                TeamId: selectedTeamId,
                Priority: TicketPriority.High
            ));
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NavigateTo(string path)
    {
        Navigation.NavigateTo(path);
        await Close();
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
