@inherits LayoutComponentBase
@implements IDisposable
@inject IApiKeyVaultService KeyVaultService
@inject IActiveProjectContext ActiveProjectContext

<div class="app-container">
    @if (isMobileMenuOpen)
    {
        <div class="sidebar-overlay" @onclick="ToggleSidebar"></div>
    }

    <NavMenu CssClass="@(isMobileMenuOpen ? "sidebar sidebar-open" : "sidebar")" OnNavigate="CloseSidebar" />

    <div class="main-content">
        <header class="top-bar">
            <div class="top-bar-brand">
                <button class="sidebar-toggle-btn" @onclick="ToggleSidebar" title="Toggle Sidebar" aria-label="Toggle navigation menu">
                    ☰
                </button>
                <span class="top-bar-title">🎪 Carnot Cycle Circus</span>
                <span class="badge top-bar-badge" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid #f59e0b;">
                    Efficiency: η = 1 - T_cold/T_hot (99.9% Caffeine)
                </span>
            </div>

            <!-- Top Bar Quick Actions & Key Swapper -->
            <div class="top-bar-actions">
                <button class="btn btn-primary" @onclick="() => showIgnitionModal = true" style="padding: 6px 12px; font-size: 0.82rem; white-space: nowrap;">
                    🚀 New Project
                </button>
                <button class="btn btn-success" @onclick="() => showHarvesterModal = true" style="padding: 6px 12px; font-size: 0.82rem; white-space: nowrap;">
                    🔍 Scan Repo
                </button>
                <button class="btn btn-secondary" @onclick="() => showShowcaseModal = true" style="padding: 6px 12px; font-size: 0.82rem; color: #f59e0b; border-color: #f59e0b; white-space: nowrap;">
                    🍿 30s Demo
                </button>
                <button class="btn btn-secondary" @onclick="() => showChaosQuoteModal = true" style="padding: 6px 12px; font-size: 0.82rem; color: #a855f7; border-color: #a855f7; white-space: nowrap;" title="Fire Comedy Chaos Cannon">
                    🎬 Chaos Cannon
                </button>

                @{
                    var activeKey = KeyVaultService.GetActiveKey();
                }
                <div class="top-bar-key-vault" title="Active Key: @(activeKey?.KeyName ?? "None")">
                    <span style="color: #eab308;">🔑</span>
                    <span style="color: var(--text-muted);">VC Burner Key:</span>
                    <span style="font-weight: 600; color: #38bdf8;">@(activeKey?.KeyName ?? "None")</span>
                    <span style="color: var(--text-muted); font-family: monospace;">(@(activeKey?.ApiKeyMasked ?? "No Key"))</span>
                </div>

                <button class="btn btn-secondary" @onclick="() => showKeyModal = true" style="padding: 6px 12px; font-size: 0.82rem; white-space: nowrap;">
                    💰 Key Vault
                </button>
            </div>
        </header>

        <main class="content-viewport">
            <CascadingValue Value="ActiveProjectContext.CurrentProject">
                @Body
            </CascadingValue>
        </main>
    </div>
</div>

@if (showKeyModal)
{
    <KeyVaultModal OnClose="() => showKeyModal = false" />
}

@if (showIgnitionModal)
{
    <ProjectIgnitionModal OnClose="() => showIgnitionModal = false" />
}

@if (showHarvesterModal)
{
    <CodebaseHarvesterModal OnClose="() => showHarvesterModal = false" />
}

@if (showShowcaseModal)
{
    <ShowcaseModal OnClose="() => showShowcaseModal = false" />
}

@if (showChaosQuoteModal)
{
    <ChaosQuoteModal OnClose="() => showChaosQuoteModal = false" />
}

@code {
    private bool showKeyModal = false;
    private bool showIgnitionModal = false;
    private bool showHarvesterModal = false;
    private bool showShowcaseModal = false;
    private bool showChaosQuoteModal = false;
    private bool isMobileMenuOpen = false;

    protected override void OnInitialized()
    {
        KeyVaultService.OnKeyUpdated += OnKeyUpdated;
        ActiveProjectContext.OnActiveProjectChanged += OnProjectChanged;
    }

    private void OnKeyUpdated(ApiKeyVaultEntry entry)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnProjectChanged(Project? project)
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleSidebar()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseSidebar()
    {
        if (isMobileMenuOpen)
        {
            isMobileMenuOpen = false;
        }
    }

    public void Dispose()
    {
        KeyVaultService.OnKeyUpdated -= OnKeyUpdated;
        ActiveProjectContext.OnActiveProjectChanged -= OnProjectChanged;
    }
}

