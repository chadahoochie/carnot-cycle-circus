@page "/dashboard"
@implements IDisposable
@using CarnotCycleCircus.Core.Domain.Approvals
@inject IGraphWorkflowExecutor GraphExecutor
@inject ITeamDefinitionManager TeamManager
@inject IAgentDefinitionManager AgentManager
@inject IAgentEventStream EventStream
@inject IApiKeyVaultService KeyVaultService
@inject ITicketStore TicketStore
@inject IWorkflowApprovalService ApprovalService
@inject IActiveProjectContext ActiveProjectContext
@inject IAgentExecutionTracker ExecutionTracker

<div class="page-header">
    <div>
        <h2 style="font-size: 1.5rem; font-weight: 700;">⚡ Panic & Telemetry Dashboard</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Live multi-agent circus stream, active execution pulses, and mandatory squad execution controls.</p>
    </div>

    <!-- Live Execution Controls with Mandatory Team Selection -->
    <div class="page-header-actions" style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
        <select class="form-control" style="width: auto; min-width: 220px; font-weight: 600;" value="@selectedTeamId" @onchange="OnTeamSelected">
            <option value="">-- Select Active Squad --</option>
            @foreach (var t in TeamManager.GetAllTeams())
            {
                <option value="@t.Id">👥 @t.Name (@t.Graph.Nodes.Count nodes)</option>
            }
        </select>

        <button class="btn btn-primary" @onclick="RunFullWorkflow" disabled="@(!HasSelectedTeam || !ActiveProjectContext.HasActiveProject || GraphExecutor.IsRunning)" style="white-space: nowrap;">
            🚀 Unleash the Circus
        </button>
        <button class="btn btn-secondary" @onclick="StepNext" disabled="@(!HasSelectedTeam || !ActiveProjectContext.HasActiveProject || GraphExecutor.IsRunning)" style="white-space: nowrap;">
            ⏭️ Poke Next Agent
        </button>
        <button class="btn btn-secondary" @onclick="Reset" style="white-space: nowrap;">
            🔄 Sweep the Tent
        </button>
        <button class="btn btn-success" @onclick="ExportReport" style="white-space: nowrap;">
            📄 CYA Session Report
        </button>

        <div style="display: flex; align-items: center; gap: 6px; background: rgba(15, 23, 42, 0.8); border: 1px solid var(--border-color); padding: 6px 12px; border-radius: 6px; font-size: 0.82rem;">
            <input type="checkbox" id="requireApprovalToggle" checked="@ApprovalService.RequireUserApproval" @onchange="OnToggleApproval" />
            <label for="requireApprovalToggle" style="margin: 0; cursor: pointer; color: #f8fafc; font-weight: 600;">
                🔒 Human Gates (@(ApprovalService.RequireUserApproval ? "Active" : "Auto-Pass"))
            </label>
        </div>
    </div>
</div>

@if (!ActiveProjectContext.HasActiveProject)
{
    <div class="glass-card" style="text-align: center; padding: 48px;">
        <div style="font-size: 2rem; margin-bottom: 12px;">📁</div>
        <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 8px;">Select a project to view telemetry</h3>
        <p style="color: var(--text-muted);">Execution telemetry and workflow runs are scoped to a project. Choose or create an active project from the sidebar switcher.</p>
    </div>
}
else
{
@if (!HasSelectedTeam)
{
    <div style="padding: 14px 18px; border-radius: 8px; margin-bottom: 20px; background: rgba(234, 179, 8, 0.15); border: 1px solid #eab308; color: #fde047; font-size: 0.92rem; display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 1.4rem;">⚠️</span>
        <div>
            <strong>Squad Selection Required:</strong> Please select an active engineering squad from the dropdown above before unleashing the circus or stepping CLAW nodes.
        </div>
    </div>
}
else if (selectedTeam != null)
{
    <div style="padding: 10px 16px; border-radius: 8px; margin-bottom: 18px; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8; font-size: 0.85rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
        <div style="display: flex; align-items: center; gap: 8px;">
            <span>👥</span>
            <span>Active Squad: <strong>@selectedTeam.Name</strong> (@selectedTeam.Graph.Nodes.Count CLAW nodes, @selectedTeam.Members.Count agents)</span>
        </div>
        <div style="font-size: 0.78rem; color: var(--text-muted);">
            Fallback Model: <span style="color: #f8fafc; font-family: monospace;">@(string.IsNullOrEmpty(selectedTeam.DefaultFallbackModel) ? "None" : selectedTeam.DefaultFallbackModel)</span>
        </div>
    </div>
}

<!-- Active Graph Pulse Status Bar -->
<div class="glass-card" style="margin-bottom: 20px; padding: 16px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
        <div style="font-size: 0.85rem; font-weight: 600; color: #38bdf8; text-transform: uppercase;">
            🎪 Ringmaster Live Stage Topology & Node Pulse
        </div>
        <div style="display: flex; align-items: center; gap: 8px; font-size: 0.8rem; flex-wrap: wrap;">
            <span>Circus State:</span>
            <span class="badge" style="background: @(GraphExecutor.IsRunning ? "#38bdf8" : "#22c55e"); color: #000; font-weight: 700;">
                @(GraphExecutor.IsRunning ? "PERFORMING (CHAOS)" : "READY / IDLE")
            </span>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px;">
        @foreach (var node in GraphExecutor.CurrentGraph.Nodes)
        {
            var isRunning = node.State == NodeExecutionState.Running;
            var isRemediating = node.State == NodeExecutionState.Remediating;
            var isCompleted = node.State == NodeExecutionState.Completed;
            var isFailed = node.State == NodeExecutionState.Failed;
            var isWaitingForApproval = node.State == NodeExecutionState.WaitingForApproval;
            var assignedAgent = !string.IsNullOrEmpty(node.AgentId) ? AgentManager.GetAgent(node.AgentId) : null;
            var displayName = assignedAgent?.Persona.Name ?? node.Name;

            var borderCol = isRunning ? "#38bdf8" : isRemediating ? "#ef4444" : isCompleted ? "#22c55e" : isWaitingForApproval ? "#f59e0b" : "var(--border-color)";
            var pulseClass = isRunning ? "pulse-running" : isRemediating ? "pulse-remediating" : isWaitingForApproval ? "pulse-waiting" : "";

            <div style="background: var(--bg-primary); border: 2px solid @borderCol; border-radius: 8px; padding: 10px; text-align: center; position: relative;" class="@pulseClass" title="@(isFailed && !string.IsNullOrWhiteSpace(node.LastOutputSummary) ? node.LastOutputSummary : displayName)">
                <div style="font-size: 1.4rem;">@node.Role.ToEmoji()</div>
                <div style="font-weight: 700; font-size: 0.8rem; color: #f8fafc; margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@displayName</div>
                <div style="font-size: 0.68rem; margin-top: 2px; color: @(isCompleted ? "#22c55e" : isFailed ? "#ef4444" : isWaitingForApproval ? "#f59e0b" : isRunning ? "#38bdf8" : "var(--text-muted)"); font-weight: @(isFailed || isWaitingForApproval || isRunning ? "700" : "normal");">
                    @(isFailed ? "⚠️ FAILED" : isWaitingForApproval ? "⏳ APPROVAL NEEDED" : isRunning ? (ExecutionTracker.CurrentExecution?.Role == node.Role && !string.IsNullOrWhiteSpace(ExecutionTracker.CurrentExecution.CurrentPhase) ? $"⚡ {ExecutionTracker.CurrentExecution.CurrentPhase}" : "⏳ LLM Inference...") : node.State.ToString())
                </div>
                @if (isFailed && !string.IsNullOrWhiteSpace(node.LastOutputSummary))
                {
                    <div style="font-size: 0.65rem; color: #f87171; margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@node.LastOutputSummary">
                        @node.LastOutputSummary
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Active Human Approval Gate Spotlight Banner -->
@if (ActiveApproval is { } activeApproval)
{
    var isRejected = activeApproval.Status == ApprovalStatus.Rejected;
    var bannerBorder = isRejected ? "#ef4444" : "#f59e0b";
    var bannerBg = isRejected 
        ? "linear-gradient(135deg, rgba(239, 68, 68, 0.22) 0%, rgba(15, 23, 42, 0.95) 100%)" 
        : "linear-gradient(135deg, rgba(245, 158, 11, 0.18) 0%, rgba(15, 23, 42, 0.95) 100%)";
    var bannerShadow = isRejected 
        ? "0 0 30px rgba(239, 68, 68, 0.35)" 
        : "0 0 30px rgba(245, 158, 11, 0.35)";
    var badgeBg = isRejected ? "#ef4444" : "#f59e0b";
    var badgeText = isRejected ? "REVISION REQUESTED" : "USER INTERACTION REQUIRED";
    var btnClass = isRejected ? "btn btn-danger" : "btn btn-warning";
    var btnShadow = isRejected 
        ? "0 0 15px rgba(239, 68, 68, 0.5)" 
        : "0 0 15px rgba(245, 158, 11, 0.5)";
    var btnText = isRejected
        ? $"📋 Review & Revise Approval Gate ({activeApproval.ItemsToApprove.Count} item{(activeApproval.ItemsToApprove.Count == 1 ? "" : "s")})"
        : $"📋 Review & Approve Gate ({activeApproval.ItemsToApprove.Count} item{(activeApproval.ItemsToApprove.Count == 1 ? "" : "s")})";

    <div class="glass-card @(isRejected ? "" : "pulse-waiting")" style="margin-bottom: 20px; padding: 18px 22px; border: 2px solid @bannerBorder; background: @bannerBg; box-shadow: @bannerShadow; border-radius: 10px;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <div style="font-size: 2.4rem; filter: drop-shadow(0 0 10px @(isRejected ? "rgba(239, 68, 68, 0.7)" : "rgba(245, 158, 11, 0.7)"));">
                    @(isRejected ? "🛑" : "✋")
                </div>
                <div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="badge" style="background: @badgeBg; color: #000; font-weight: 800; font-size: 0.75rem; padding: 3px 10px;">
                            @badgeText
                        </span>
                        <h3 style="font-weight: 800; font-size: 1.2rem; color: #f8fafc; margin: 0;">
                            @activeApproval.GateTitle
                        </h3>
                    </div>
                    <p style="font-size: 0.88rem; color: @(isRejected ? "#fca5a5" : "#fde047"); margin-top: 5px; margin-bottom: 0; line-height: 1.4;">
                        @(isRejected && !string.IsNullOrWhiteSpace(activeApproval.UserFeedback) ? $"Revision Directive: {activeApproval.UserFeedback}" : activeApproval.GateDescription)
                    </p>
                    <div style="font-size: 0.8rem; color: #38bdf8; margin-top: 4px;">
                        ⚡ <strong>Next Step:</strong> @activeApproval.NextStepDescription
                    </div>
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                <button class="@btnClass" style="font-weight: 700; padding: 10px 20px; font-size: 0.95rem; border: none; box-shadow: @btnShadow;" @onclick="() => OpenApprovalModal(activeApproval)">
                    @btnText
                </button>
            </div>
        </div>
    </div>
}

<!-- Active Execution Spotlight & Live Telemetry HUD -->
@if (GraphExecutor.IsRunning || GraphExecutor.CurrentActiveExecution != null)
{
    var exec = GraphExecutor.CurrentActiveExecution;
    <div class="glass-card" style="margin-bottom: 20px; padding: 16px; border: 1.5px solid #38bdf8; background: linear-gradient(135deg, rgba(56, 189, 248, 0.1) 0%, rgba(15, 23, 42, 0.8) 100%); box-shadow: 0 0 25px rgba(56, 189, 248, 0.2); border-radius: 10px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 10px;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="font-size: 2.2rem; filter: drop-shadow(0 0 10px rgba(56, 189, 248, 0.5));">
                    @(exec?.Role.ToEmoji() ?? "🎪")
                </div>
                <div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <h3 style="font-weight: 800; font-size: 1.15rem; color: #f8fafc; margin: 0;">
                            @(exec != null ? $"{exec.Role.ToDisplayName()} ({exec.RoleName})" : "Circus Swarm Orchestrator")
                        </h3>
                        <span class="badge" style="background: #38bdf8; color: #000; font-weight: 800; font-size: 0.72rem; padding: 2px 8px;">
                            @(exec?.CurrentPhase ?? "Executing...")
                        </span>
                    </div>
                    <div style="font-size: 0.85rem; color: #7dd3fc; margin-top: 3px; font-weight: 500;">
                        @(exec != null ? $"Ticket [{exec.TicketId}]: {exec.TicketTitle}" : "Autonomous CLAW Swarm execution in progress...")
                    </div>
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 10px; font-size: 0.82rem; flex-wrap: wrap;">
                <div style="background: rgba(15, 23, 42, 0.9); border: 1px solid rgba(56, 189, 248, 0.5); padding: 6px 12px; border-radius: 6px; font-family: monospace; color: #38bdf8; font-weight: 700;">
                    ⏱️ @GetElapsedTime(exec?.StartedAt)
                </div>
                <div style="background: rgba(15, 23, 42, 0.9); border: 1px solid var(--border-color); padding: 6px 12px; border-radius: 6px; font-family: monospace; color: #cbd5e1; font-size: 0.78rem;">
                    🤖 @(exec?.Model ?? "Auto-Resolved")
                </div>
                <div style="background: rgba(15, 23, 42, 0.9); border: 1px solid var(--border-color); padding: 6px 12px; border-radius: 6px; color: #a855f7; font-weight: 600;">
                    ⚡ @(exec?.ChunksReceived ?? 0) token chunk(s)
                </div>
                <button class="btn btn-secondary" style="font-size: 0.78rem; padding: 6px 12px; display: flex; align-items: center; gap: 6px; font-weight: 600;"
                        @onclick="() => { activityModalTicketId = exec?.TicketId; showActivityModal = true; }">
                    🔬 Detailed Inspector
                </button>
            </div>
        </div>

        <!-- Live Model Token Stream / Thought Preview Terminal -->
        <div style="background: #030712; border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 8px; padding: 12px 16px; font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace; font-size: 0.8rem; color: #e2e8f0; max-height: 140px; overflow-y: auto; box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.8);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 4px;">
                <div style="color: #38bdf8; font-size: 0.72rem; text-transform: uppercase; font-weight: 700; display: flex; align-items: center; gap: 6px;">
                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 8px #22c55e;"></span>
                    Live Streaming Output / AST Synthesis
                </div>
                <span style="font-size: 0.7rem; color: #64748b;">
                    SSE Stream: active
                </span>
            </div>
            <div style="white-space: pre-wrap; word-break: break-word; line-height: 1.55; color: #f1f5f9;">
                @(string.IsNullOrWhiteSpace(exec?.LastSnippet) ? "Awaiting first token chunk from model inference engine..." : exec.LastSnippet)<span style="display: inline-block; width: 8px; height: 14px; background: #38bdf8; margin-left: 2px; vertical-align: middle;"></span>
            </div>
        </div>
    </div>
}

@if (GraphExecutor.CurrentActiveExecution == null && ExecutionTracker.LastExecution is { } lastExec)
{
    <div style="background: rgba(15, 23, 42, 0.65); border: 1px solid var(--border-color); border-radius: 8px; padding: 10px 16px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 0.82rem;">
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            <span style="color: var(--text-muted);">📋 Last Completed Task:</span>
            <span style="color: @lastExec.Role.ToColorHex(); font-weight: 700;">@lastExec.Role.ToEmoji() @lastExec.Role.ToDisplayName()</span>
            <span style="color: #f8fafc; font-weight: 600;">[@lastExec.TicketId]</span>
            <span style="color: var(--text-muted); max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@lastExec.TicketTitle</span>
            <span class="badge" style="background: @(lastExec.IsSuccess ? "rgba(34,197,94,0.2)" : "rgba(239,68,68,0.2)"); color: @(lastExec.IsSuccess ? "#22c55e" : "#ef4444"); border: 1px solid @(lastExec.IsSuccess ? "#22c55e" : "#ef4444"); font-size: 0.7rem;">
                @(lastExec.IsSuccess ? "✔ Succeeded" : "✖ Failed")
            </span>
            @if (lastExec.IsFallbackActive)
            {
                <span class="badge" style="background: rgba(245,158,11,0.2); color: #f59e0b; border: 1px solid #f59e0b; font-size: 0.7rem;">⚠️ Fallback Used</span>
            }
        </div>
        <button class="btn btn-secondary" style="font-size: 0.76rem; padding: 4px 10px; display: flex; align-items: center; gap: 6px;"
                @onclick="() => { activityModalTicketId = lastExec.TicketId; showActivityModal = true; }">
            🔬 View Agent Activity Trace
        </button>
    </div>
}

<!-- Main Execution Stream & Live Tools -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px;">
    
    <!-- Real-Time Event Stream Log -->
    <div class="glass-card" style="display: flex; flex-direction: column; height: 520px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
            <div style="font-weight: 700; font-size: 0.95rem; display: flex; align-items: center; gap: 8px;">
                <span>📡</span> Live Agent Event Stream (@ScopedMessages.Count messages)
            </div>
            <button class="btn btn-secondary" style="padding: 2px 8px; font-size: 0.75rem;" @onclick="ClearStream">Clear</button>
        </div>

        <div style="flex-grow: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding-right: 6px;">
            @foreach (var msg in ScopedMessages)
            {
                var bg = msg.Type switch
                {
                    MessageType.Alert => "rgba(239, 68, 68, 0.15)",
                    MessageType.Handoff => "rgba(168, 85, 247, 0.15)",
                    MessageType.StateChange => "rgba(56, 189, 248, 0.1)",
                    MessageType.ArtifactCreated => "rgba(34, 197, 94, 0.15)",
                    MessageType.Thought => "rgba(147, 51, 234, 0.1)",
                    _ => "var(--bg-primary)"
                };

                var border = msg.Type switch
                {
                    MessageType.Alert => "#ef4444",
                    MessageType.Handoff => "#a855f7",
                    MessageType.StateChange => "#38bdf8",
                    MessageType.ArtifactCreated => "#22c55e",
                    MessageType.Thought => "#a855f7",
                    _ => "var(--border-color)"
                };

                <div style="background: @bg; border-left: 3px solid @border; padding: 8px 12px; border-radius: 4px; font-size: 0.82rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                        <span style="font-weight: 700; color: #f8fafc; display: flex; align-items: center; gap: 6px;">
                            @(msg.Role?.ToEmoji() ?? (msg.Type == MessageType.ArtifactCreated ? "📄" : "📢")) @msg.SenderName
                            @if (msg.Type == MessageType.ArtifactCreated)
                            {
                                <span class="badge" style="background: #22c55e; color: #000; font-size: 0.65rem; padding: 1px 6px;">DELIVERABLE</span>
                            }
                            else if (msg.Type == MessageType.Thought)
                            {
                                <span class="badge" style="background: #a855f7; color: #fff; font-size: 0.65rem; padding: 1px 6px;">THOUGHT</span>
                            }
                        </span>
                        <span style="font-size: 0.7rem; color: var(--text-muted);">
                            @msg.Timestamp.ToString("HH:mm:ss")
                        </span>
                    </div>
                    <div style="color: var(--text-main); white-space: pre-wrap; font-size: 0.8rem; line-height: 1.4; font-style: @(msg.Type == MessageType.Thought ? "italic" : "normal");">@msg.Content</div>
                    @if (!string.IsNullOrEmpty(msg.TicketId))
                    {
                        <div style="margin-top: 4px; font-size: 0.7rem; color: var(--text-muted); font-family: monospace;">
                            Ticket: @msg.TicketId
                        </div>
                    }
                </div>
            }
            @if (ScopedMessages.Count == 0)
            {
                <div style="text-align: center; color: var(--text-muted); padding: 40px 10px;">
                    <div style="font-size: 1.8rem; margin-bottom: 6px;">🦗</div>
                    <div>Tent is quiet. Select a squad and unleash the circus to view live logs!</div>
                </div>
            }
        </div>
    </div>

    <!-- Side Control Column -->
    <div style="display: flex; flex-direction: column; gap: 20px;">
        
        <!-- Mid-Flight OpenRouter Key Swapper -->
        <div class="glass-card">
            <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                <span>🔑</span> Mid-Flight Ammo Key Swapper
            </h3>
            
            <div class="form-group">
                <label class="form-label">Global Active OpenRouter Key</label>
                <select class="form-control" value="@(KeyVaultService.GetActiveKey()?.KeyId ?? "")" @onchange="OnKeySwapped">
                    <option value="">-- No Active API Key --</option>
                    @foreach (var key in KeyVaultService.GetAllKeys())
                    {
                        <option value="@key.KeyId">@key.KeyName (@key.ApiKeyMasked)</option>
                    }
                </select>
                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">
                    Hot-swap your LLM API tokens in mid-execution if rate limits trip.
                </div>
            </div>
        </div>

        <!-- Real-Time Metrics & Graveyard Stats -->
        <div class="glass-card">
            <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                <span>📊</span> Live Circus Telemetry
            </h3>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div style="background: var(--bg-primary); padding: 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Ready Tickets</div>
                    <div style="font-size: 1.4rem; font-weight: 800; color: #38bdf8;">
                        @ScopedReadyTicketCount
                    </div>
                </div>
                <div style="background: var(--bg-primary); padding: 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Done Tickets</div>
                    <div style="font-size: 1.4rem; font-weight: 800; color: #22c55e;">
                        @ScopedTickets.Count(t => t.Status == TicketStatus.Done)
                    </div>
                </div>
                <div style="background: var(--bg-primary); padding: 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Total Handoffs</div>
                    <div style="font-size: 1.4rem; font-weight: 800; color: #a855f7;">
                        @ScopedHandoffs.Count
                    </div>
                </div>
                <div style="background: var(--bg-primary); padding: 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Failed Nodes</div>
                    <div style="font-size: 1.4rem; font-weight: 800; color: #ef4444;">
                        @GraphExecutor.CurrentGraph.Nodes.Count(n => n.State == NodeExecutionState.Failed)
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
}

<!-- CYA Report Modal -->
@if (showReportModal)
{
    <div class="modal-backdrop" @onclick="() => showReportModal = false">
        <div class="modal-dialog" style="max-width: 750px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 style="font-size: 1.15rem; font-weight: 700;">📄 CYA Executive Session Report</h3>
                <button class="btn btn-secondary" @onclick="() => showReportModal = false" style="padding: 4px 8px;">✕</button>
            </div>
            <div class="modal-body">
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 10px;">
                    Standard-compliant markdown report summarizing all delivered tickets, generated artifacts, and inter-agent handoff chains.
                </p>
                <textarea class="form-control" style="height: 300px; font-family: monospace; font-size: 0.8rem;" readonly>@sessionReportMarkdown</textarea>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showReportModal = false">Close</button>
            </div>
        </div>
    </div>
}

<!-- Human Approval Gate Modal -->
@if (showApprovalModal)
{
    var modalRequest = selectedApprovalRequest ?? ActiveApproval;
    @if (modalRequest != null)
    {
        <WorkflowApprovalModal Request="@modalRequest" OnClose="HandleCloseApprovalModal" />
    }
}

<!-- Agent Activity Detailed Inspector Modal -->
@if (showActivityModal)
{
    <AgentActivityModal TicketId="@activityModalTicketId" OnClose="() => { showActivityModal = false; activityModalTicketId = null; }" />
}

@code {
    private string selectedTeamId = "";
    private TeamDefinition? selectedTeam => !string.IsNullOrEmpty(selectedTeamId) ? TeamManager.GetTeam(selectedTeamId) : null;
    private bool HasSelectedTeam => !string.IsNullOrWhiteSpace(selectedTeamId);

    private WorkflowApprovalRequest? ActiveApproval =>
        ApprovalService.CurrentPendingRequest 
        ?? ApprovalService.GetLatestPendingOrRejectedRequestForProject(ActiveProjectContext.CurrentProjectId);

    private bool showReportModal;
    private bool showApprovalModal;
    private WorkflowApprovalRequest? selectedApprovalRequest;
    private bool showActivityModal;
    private string? activityModalTicketId;
    private string sessionReportMarkdown = "";

    private System.Threading.Timer? _uiTimer;
    private DateTimeOffset? _workflowStartedAt;

    private IReadOnlyList<AgentMessage> ScopedMessages =>
        EventStream.GetRecentMessages(ActiveProjectContext.CurrentProjectId, 1000);

    private IReadOnlyList<TicketItem> ScopedTickets =>
        ActiveProjectContext.CurrentProjectId is { } projectId
            ? TicketStore.GetByProject(projectId)
            : Array.Empty<TicketItem>();

    private int ScopedReadyTicketCount =>
        ActiveProjectContext.CurrentProjectId is { } projectId
            ? TicketStore.GetReadyTickets().Count(t => string.Equals(t.ProjectId, projectId, StringComparison.OrdinalIgnoreCase))
            : 0;

    private IReadOnlyList<HandoffPacket> ScopedHandoffs =>
        ActiveProjectContext.CurrentProjectId is { } projectId
            ? TicketStore.GetAllHandoffs().Where(h => string.Equals(h.ProjectId, projectId, StringComparison.OrdinalIgnoreCase)).ToList()
            : Array.Empty<HandoffPacket>();

    private void OnToggleApproval(ChangeEventArgs e)
    {
        ApprovalService.RequireUserApproval = (bool)(e.Value ?? true);
    }

    private string GetElapsedTime(DateTimeOffset? startedAt)
    {
        var start = startedAt ?? _workflowStartedAt;
        if (!start.HasValue) return "00:00s";
        var elapsed = DateTimeOffset.UtcNow - start.Value;
        return $"{(int)elapsed.TotalMinutes:D2}:{elapsed.Seconds:D2}s";
    }

    protected override void OnInitialized()
    {
        var currentTeam = TeamManager.GetCurrentTeamDefinition() ?? TeamManager.GetAllTeams().FirstOrDefault();
        if (currentTeam != null)
        {
            selectedTeamId = currentTeam.Id;
            GraphExecutor.LoadTeam(currentTeam);
        }

        EventStream.OnMessagePublished += HandleMessagePublished;
        GraphExecutor.OnGraphUpdated += HandleGraphUpdated;
        GraphExecutor.OnActiveExecutionChanged += HandleActiveExecutionChanged;
        ExecutionTracker.OnExecutionUpdated += HandleExecutionTrackerUpdated;
        TeamManager.OnCurrentTeamChanged += HandleTeamChanged;
        ApprovalService.OnApprovalRequested += HandleApprovalRequested;
        ApprovalService.OnApprovalResolved += HandleApprovalResolved;
        ActiveProjectContext.OnActiveProjectChanged += HandleActiveProjectChanged;

        var activeApproval = ActiveApproval;
        if (activeApproval != null && activeApproval.Status == ApprovalStatus.Pending)
        {
            selectedApprovalRequest = activeApproval;
            showApprovalModal = true;
        }

        _uiTimer = new System.Threading.Timer(_ =>
        {
            if (GraphExecutor.IsRunning || GraphExecutor.CurrentActiveExecution != null)
            {
                InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    private void HandleApprovalRequested(WorkflowApprovalRequest req)
    {
        selectedApprovalRequest = req;
        showApprovalModal = true;
        InvokeAsync(StateHasChanged);
    }

    private void HandleApprovalResolved(WorkflowApprovalRequest _)
    {
        showApprovalModal = false;
        selectedApprovalRequest = null;
        InvokeAsync(StateHasChanged);
    }

    private void OpenApprovalModal(WorkflowApprovalRequest req)
    {
        selectedApprovalRequest = req;
        showApprovalModal = true;
    }

    private void HandleCloseApprovalModal()
    {
        showApprovalModal = false;
        selectedApprovalRequest = null;
    }

    private void HandleExecutionTrackerUpdated(AgentExecutionTrace? _) => InvokeAsync(StateHasChanged);
    private void HandleActiveProjectChanged(Project? _) => InvokeAsync(StateHasChanged);
    private void HandleActiveExecutionChanged(ActiveExecutionStatus? _) => InvokeAsync(StateHasChanged);
    private void HandleMessagePublished(AgentMessage _) => InvokeAsync(StateHasChanged);
    private void HandleGraphUpdated(WorkflowGraph _) => InvokeAsync(StateHasChanged);

    private void HandleTeamChanged(EngineeringTeam team)
    {
        selectedTeamId = team.Id;
        InvokeAsync(StateHasChanged);
    }

    private void OnTeamSelected(ChangeEventArgs e)
    {
        var id = e.Value?.ToString() ?? "";
        selectedTeamId = id;
        if (!string.IsNullOrEmpty(id))
        {
            var team = TeamManager.GetTeam(id);
            if (team != null)
            {
                TeamManager.SwitchToTeam(id);
                GraphExecutor.LoadTeam(team);
            }
        }
    }

    public void Dispose()
    {
        _uiTimer?.Dispose();
        EventStream.OnMessagePublished -= HandleMessagePublished;
        GraphExecutor.OnGraphUpdated -= HandleGraphUpdated;
        GraphExecutor.OnActiveExecutionChanged -= HandleActiveExecutionChanged;
        ExecutionTracker.OnExecutionUpdated -= HandleExecutionTrackerUpdated;
        TeamManager.OnCurrentTeamChanged -= HandleTeamChanged;
        ApprovalService.OnApprovalRequested -= HandleApprovalRequested;
        ApprovalService.OnApprovalResolved -= HandleApprovalResolved;
        ActiveProjectContext.OnActiveProjectChanged -= HandleActiveProjectChanged;
    }

    private async Task RunFullWorkflow()
    {
        if (!HasSelectedTeam || !ActiveProjectContext.HasActiveProject) return;
        _workflowStartedAt = DateTimeOffset.UtcNow;

        try
        {
            var activeEpic = ScopedTickets.FirstOrDefault(t => t.Type == TicketType.Epic && t.Status != TicketStatus.Done);
            if (activeEpic != null)
            {
                await GraphExecutor.ExecuteWorkflowAsync(activeEpic.Title, activeEpic.Description);
                return;
            }

            var readyTickets = TicketStore.GetReadyTickets()
                .Where(t => string.Equals(t.ProjectId, ActiveProjectContext.CurrentProjectId, StringComparison.OrdinalIgnoreCase))
                .Where(t => t.Type != TicketType.Epic && t.Status != TicketStatus.Done)
                .ToList();
            if (readyTickets.Count > 0)
            {
                await GraphExecutor.ExecuteReadyTicketsAsync();
                return;
            }

            EventStream.Publish(AgentMessage.Create(
                role: null,
                senderName: "🎪 Circus Ringmaster",
                content: "⚠️ No active epics or ready tickets in the queue! Click '🚀 New Project' in the top bar to ignite an initiative first.",
                type: MessageType.Alert
            ));
        }
        catch (Exception ex)
        {
            EventStream.Publish(AgentMessage.Create(
                role: null,
                senderName: "🎪 Circus Ringmaster",
                content: $"🛑 Execution halted: {ex.Message}",
                type: MessageType.Alert
            ));
        }
    }

    private async Task StepNext()
    {
        if (!HasSelectedTeam) return;

        try
        {
            await GraphExecutor.StepNextNodeAsync();
        }
        catch (Exception ex)
        {
            EventStream.Publish(AgentMessage.Create(
                role: null,
                senderName: "🎪 Circus Ringmaster",
                content: $"🛑 Step execution halted: {ex.Message}",
                type: MessageType.Alert
            ));
        }
    }

    private void Reset()
    {
        GraphExecutor.ResetGraph();
        var inProgressTickets = ScopedTickets.Where(t => t.Status == TicketStatus.InProgress).ToList();
        foreach (var t in inProgressTickets)
        {
            TicketStore.UpdateTicket(t.WithStatus(TicketStatus.Ready));
        }
    }

    private void ClearStream()
    {
        EventStream.Clear();
    }

    private void OnKeySwapped(ChangeEventArgs e)
    {
        var keyId = e.Value?.ToString();
        if (!string.IsNullOrEmpty(keyId))
        {
            KeyVaultService.SetActiveKey(keyId);
        }
    }

    private void ExportReport()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("# Carnot Cycle Circus - Autonomous Engineering Execution Report");
        sb.AppendLine($"Generated at: {DateTimeOffset.UtcNow:yyyy-MM-dd HH:mm:ss} UTC\n");
        sb.AppendLine($"## Active Squad: {(selectedTeam?.Name ?? "None")}\n");
        sb.AppendLine("## Summary of Delivered Tickets");
        foreach (var t in ScopedTickets)
        {
            sb.AppendLine($"- [{t.Status}] **{t.Id}** ({t.AssigneeRole.ToDisplayName()}): {t.Title}");
            foreach (var d in t.Deliverables)
            {
                sb.AppendLine($"  - Artifact: `{d.Name}` ({d.ContentType})");
            }
        }
        sb.AppendLine("\n## Inter-Agent Handoff Chain");
        foreach (var ho in ScopedHandoffs)
        {
            sb.AppendLine($"- [{ho.Timestamp:HH:mm:ss}] {ho.FromAgentRole.ToDisplayName()} ➔ {ho.ToAgentRole.ToDisplayName()} (Ticket {ho.TicketId}): {ho.ContextSummary}");
        }

        sessionReportMarkdown = sb.ToString();
        showReportModal = true;
    }
}
