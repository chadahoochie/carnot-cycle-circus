@page "/artifacts"
@implements IDisposable
@inject IArtifactManager ArtifactManager
@inject ITicketStore TicketStore
@inject IJSRuntime JSRuntime
@inject IActiveProjectContext ActiveProjectContext

<div class="page-header">
    <div>
        <h2 style="font-size: 1.5rem; font-weight: 700;">📦 Deliverables & Artifacts Hub</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">
            Real-time repository-synced deliverables generated by autonomous agents (C# source code, Nygard ADRs, STRIDE models, Benchmark profiles, and QA scorecards).
        </p>
    </div>

    @if (ActiveProjectContext.HasActiveProject)
    {
        <div class="page-header-actions" style="display: flex; gap: 10px; align-items: center;">
            <button class="btn btn-success" @onclick="SyncAllArtifactsToDisk" disabled="@isSyncing" style="white-space: nowrap; font-weight: 700;">
                @(isSyncing ? "⏳ Syncing..." : "⚡ Sync All to Repo")
            </button>
            <button class="btn btn-secondary" @onclick="RefreshArtifacts" style="white-space: nowrap;">
                🔄 Refresh
            </button>
        </div>
    }
</div>

@if (!ActiveProjectContext.HasActiveProject)
{
    <div class="glass-card" style="text-align: center; padding: 48px;">
        <div style="font-size: 2rem; margin-bottom: 12px;">📁</div>
        <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 8px;">Select a project to view artifacts</h3>
        <p style="color: var(--text-muted);">Deliverables are scoped to a project. Choose or create an active project from the sidebar switcher.</p>
    </div>
}
else
{
<!-- Storage & Sync Status Banner -->
<div class="glass-card" style="margin-bottom: 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; background: rgba(15, 23, 42, 0.65);">
    <div>
        <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Repository Artifacts Path</div>
        <div style="font-family: monospace; font-size: 0.85rem; color: #38bdf8; word-break: break-all; margin-top: 4px;">
            @ArtifactManager.ArtifactsDirectory
        </div>
    </div>
    <div>
        <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Storage Status</div>
        <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px;">
            @if (ArtifactManager.IsArtifactsDirectoryWriteable)
            {
                <span class="badge" style="background: rgba(34, 197, 94, 0.2); color: #22c55e; border: 1px solid #22c55e;">✔ Writeable to Repo</span>
            }
            else
            {
                <span class="badge" style="background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid #ef4444;">✖ Read Only</span>
            }
            <span style="font-size: 0.8rem; color: var(--text-muted);">@artifacts.Count deliverables</span>
        </div>
    </div>
    <div>
        <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Categories Breakdown</div>
        <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; font-size: 0.75rem;">
            <span class="badge" style="background: #6366f1;">🔬 Research: @artifacts.Count(a => a.Category == "Research")</span>
            <span class="badge" style="background: #a855f7;">📋 PRDs: @artifacts.Count(a => a.Category == "PRD")</span>
            <span class="badge" style="background: #3b82f6;">🏛️ ADRs: @artifacts.Count(a => a.Category == "ADR")</span>
            <span class="badge" style="background: #10b981;">💻 Code: @artifacts.Count(a => a.Category == "Code")</span>
            <span class="badge" style="background: #ef4444;">🛡️ Sec: @artifacts.Count(a => a.Category == "Security")</span>
            <span class="badge" style="background: #f59e0b;">⚡ Perf: @artifacts.Count(a => a.Category == "Benchmark")</span>
            <span class="badge" style="background: #8b5cf6;">🧪 QA: @artifacts.Count(a => a.Category == "QA")</span>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div style="background: rgba(34, 197, 94, 0.15); border: 1px solid #22c55e; color: #22c55e; padding: 10px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 0.88rem; display: flex; justify-content: space-between; align-items: center;">
        <span>@statusMessage</span>
        <button style="background: transparent; border: none; color: #22c55e; cursor: pointer;" @onclick="() => statusMessage = null">✕</button>
    </div>
}

<!-- Filters Bar -->
<div style="display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; align-items: center; justify-content: space-between;">
    <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
        <button class="btn @(selectedCategory == "All" ? "btn-primary" : "btn-secondary")" @onclick='() => selectedCategory = "All"'>
            All (@artifacts.Count)
        </button>
        <button class="btn @(selectedCategory == "Research" ? "btn-primary" : "btn-secondary")" @onclick='() => selectedCategory = "Research"'>
            🔬 Research (@artifacts.Count(a => a.Category == "Research"))
        </button>
        <button class="btn @(selectedCategory == "PRD" ? "btn-primary" : "btn-secondary")" @onclick='() => selectedCategory = "PRD"'>
            📋 PRDs (@artifacts.Count(a => a.Category == "PRD"))
        </button>
        <button class="btn @(selectedCategory == "ADR" ? "btn-primary" : "btn-secondary")" @onclick='() => selectedCategory = "ADR"'>
            🏛️ ADRs (@artifacts.Count(a => a.Category == "ADR"))
        </button>
        <button class="btn @(selectedCategory == "Code" ? "btn-primary" : "btn-secondary")" @onclick='() => selectedCategory = "Code"'>
            💻 Code (@artifacts.Count(a => a.Category == "Code"))
        </button>
        <button class="btn @(selectedCategory == "Security" ? "btn-primary" : "btn-secondary")" @onclick='() => selectedCategory = "Security"'>
            🛡️ Security (@artifacts.Count(a => a.Category == "Security"))
        </button>
        <button class="btn @(selectedCategory == "Benchmark" ? "btn-primary" : "btn-secondary")" @onclick='() => selectedCategory = "Benchmark"'>
            ⚡ Benchmarks (@artifacts.Count(a => a.Category == "Benchmark"))
        </button>
        <button class="btn @(selectedCategory == "QA" ? "btn-primary" : "btn-secondary")" @onclick='() => selectedCategory = "QA"'>
            🧪 QA Scorecards (@artifacts.Count(a => a.Category == "QA"))
        </button>
    </div>

    <div style="display: flex; gap: 10px; align-items: center;">
        <input type="text" class="form-control" placeholder="🔍 Search artifacts or tickets..." @bind="searchQuery" @bind:event="oninput" style="max-width: 260px; font-size: 0.85rem;" />
    </div>
</div>

<!-- Main Artifacts Explorer View -->
@if (FilteredArtifacts.Count == 0)
{
    <div class="glass-card" style="text-align: center; padding: 48px 20px;">
        <div style="font-size: 3rem; margin-bottom: 12px;">📁</div>
        <h3 style="color: #f8fafc; font-size: 1.2rem; font-weight: 700;">No Deliverables Found</h3>
        <p style="color: var(--text-muted); font-size: 0.9rem; max-width: 500px; margin: 8px auto 20px;">
            Execute agent workflows or tickets in the Jira Graveyard or Workflow Canvas to produce and auto-export real code and document deliverables.
        </p>
        <button class="btn btn-primary" @onclick="SyncAllArtifactsToDisk">
            ⚡ Scan & Export Existing Tickets
        </button>
    </div>
}
else
{
    <div style="display: grid; grid-template-columns: minmax(320px, 380px) 1fr; gap: 20px; align-items: start;">
        <!-- Left Artifact List -->
        <div style="display: flex; flex-direction: column; gap: 10px; max-height: calc(100vh - 280px); overflow-y: auto; padding-right: 4px;">
            @foreach (var artifact in FilteredArtifacts)
            {
                var isSelected = selectedArtifact?.FullPath == artifact.FullPath || (selectedArtifact?.Name == artifact.Name && selectedArtifact?.TicketId == artifact.TicketId);
                <div class="glass-card" style="cursor: pointer; border-left: 4px solid @GetCategoryColor(artifact.Category); background: @(isSelected ? "rgba(56, 189, 248, 0.12)" : "rgba(30, 41, 59, 0.6)"); padding: 12px 14px;"
                     @onclick="() => selectedArtifact = artifact">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                        <span style="font-weight: 700; font-size: 0.85rem; color: #f8fafc; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            📄 @artifact.Name
                        </span>
                        <span class="badge" style="background: @GetCategoryColor(artifact.Category); color: #000; font-weight: 700; font-size: 0.65rem;">
                            @artifact.Category
                        </span>
                    </div>

                    @if (!string.IsNullOrEmpty(artifact.TicketId))
                    {
                        <div style="display: flex; align-items: center; gap: 6px; margin: 4px 0;">
                            <span class="badge" style="background: @(artifact.Role?.ToColorHex() ?? "#64748b"); color: #000; font-size: 0.65rem; font-weight: 700;">
                                @artifact.TicketId
                            </span>
                            <span style="font-size: 0.75rem; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                @artifact.TicketTitle
                            </span>
                        </div>
                    }

                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.72rem; color: var(--text-muted); margin-top: 6px;">
                        <span>@(artifact.Role?.ToDisplayName() ?? "Circus Agent")</span>
                        <span>@(artifact.SizeBytes < 1024 ? $"{artifact.SizeBytes} B" : $"{artifact.SizeBytes / 1024.0:F1} KB")</span>
                    </div>
                </div>
            }
        </div>

        <!-- Right Preview Panel -->
        <div class="glass-card" style="min-height: 480px; display: flex; flex-direction: column;">
            @if (selectedArtifact != null)
            {
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px; flex-wrap: wrap; gap: 10px;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                            <span class="badge" style="background: @GetCategoryColor(selectedArtifact.Category); color: #000; font-weight: 700;">
                                @selectedArtifact.Category
                            </span>
                            <h3 style="font-size: 1.15rem; font-weight: 700; color: #f8fafc; margin: 0;">
                                @selectedArtifact.Name
                            </h3>
                        </div>
                        <div style="font-size: 0.78rem; color: var(--text-muted);">
                            @selectedArtifact.Description
                        </div>
                        <div style="font-family: monospace; font-size: 0.75rem; color: #38bdf8; margin-top: 6px; background: rgba(0, 0, 0, 0.3); padding: 4px 8px; border-radius: 4px; display: inline-block;">
                            📁 @selectedArtifact.RelativePath
                        </div>
                    </div>

                    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                        <button class="btn btn-secondary" @onclick="CopyFilePath" style="font-size: 0.78rem; padding: 5px 10px;">
                            📋 Copy Path
                        </button>
                        <button class="btn btn-primary" @onclick="CopyContent" style="font-size: 0.78rem; padding: 5px 10px;">
                            📋 Copy Content
                        </button>
                    </div>
                </div>

                <!-- Code / Markdown Display -->
                <div style="flex: 1; overflow-y: auto; background: #0f172a; border-radius: 8px; border: 1px solid var(--border-color); padding: 14px;">
                    <pre style="margin: 0; font-family: 'JetBrains Mono', 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.5; color: #e2e8f0; white-space: pre-wrap; word-break: break-word;">@selectedArtifact.Content</pre>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 300px; color: var(--text-muted);">
                    <span style="font-size: 2.5rem; margin-bottom: 10px;">📄</span>
                    <span>Select an artifact from the list to preview its contents and repo file path.</span>
                </div>
            }
        </div>
    </div>
}
}

@code {
    private List<ArtifactDescriptor> artifacts = new();
    private ArtifactDescriptor? selectedArtifact;
    private string selectedCategory = "All";
    private string searchQuery = "";
    private bool isSyncing = false;
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        ActiveProjectContext.OnActiveProjectChanged += HandleActiveProjectChanged;
        RefreshArtifacts();
        if (artifacts.Count == 0 && ActiveProjectContext.HasActiveProject)
        {
            await SyncAllArtifactsToDisk();
        }
        else
        {
            selectedArtifact = artifacts.FirstOrDefault();
        }
    }

    private void HandleActiveProjectChanged(Project? _)
    {
        RefreshArtifacts();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ActiveProjectContext.OnActiveProjectChanged -= HandleActiveProjectChanged;
    }

    private void RefreshArtifacts()
    {
        artifacts = ActiveProjectContext.CurrentProjectId is { } projectId
            ? ArtifactManager.GetByProject(projectId).ToList()
            : new List<ArtifactDescriptor>();
        if (selectedArtifact == null || !artifacts.Any(a => a.FullPath == selectedArtifact.FullPath))
        {
            selectedArtifact = artifacts.FirstOrDefault();
        }
    }

    private async Task SyncAllArtifactsToDisk()
    {
        isSyncing = true;
        statusMessage = null;
        try
        {
            var count = await ArtifactManager.ExportAllDeliverablesAsync();
            await TicketStore.FlushAsync();
            RefreshArtifacts();
            statusMessage = $"✅ Successfully synced and wrote {count} deliverable files to '{ArtifactManager.ArtifactsDirectory}'!";
        }
        catch (Exception ex)
        {
            statusMessage = $"⚠️ Error syncing artifacts: {ex.Message}";
        }
        finally
        {
            isSyncing = false;
        }
    }

    private List<ArtifactDescriptor> FilteredArtifacts => artifacts
        .Where(a => selectedCategory == "All" || string.Equals(a.Category, selectedCategory, StringComparison.OrdinalIgnoreCase))
        .Where(a => string.IsNullOrWhiteSpace(searchQuery) ||
                    a.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (a.TicketId?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (a.TicketTitle?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    a.Content.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private string GetCategoryColor(string category) => category switch
    {
        "PRD" => "#a855f7",
        "ADR" => "#38bdf8",
        "Code" => "#10b981",
        "Security" => "#ef4444",
        "Benchmark" => "#f59e0b",
        "QA" => "#8b5cf6",
        _ => "#94a3b8"
    };

    private async Task CopyFilePath()
    {
        if (selectedArtifact == null) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", selectedArtifact.FullPath);
            statusMessage = $"📋 Copied path '{selectedArtifact.FullPath}' to clipboard!";
        }
        catch
        {
            statusMessage = $"Path: {selectedArtifact.FullPath}";
        }
    }

    private async Task CopyContent()
    {
        if (selectedArtifact == null) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", selectedArtifact.Content);
            statusMessage = $"📋 Copied content of '{selectedArtifact.Name}' to clipboard!";
        }
        catch
        {
            statusMessage = "Unable to access system clipboard.";
        }
    }
}
