@page "/tickets"
@implements IDisposable
@inject ITicketStore TicketStore
@inject IHandoffRouter HandoffRouter
@inject IGraphWorkflowExecutor GraphExecutor
@inject IActiveProjectContext ActiveProjectContext

<div class="page-header">
    <div>
        <h2 style="font-size: 1.5rem; font-weight: 700;">📋 The Jira Graveyard & Ticket Backlog</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Track autonomous ticket lifecycle states, inspect backlog hierarchy, and monitor inter-agent handoff contracts.</p>
    </div>

    @if (ActiveProjectContext.HasActiveProject)
    {
        <div class="page-header-actions">
            <button class="btn @(activeTab == "kanban" ? "btn-primary" : "btn-secondary")" @onclick='() => activeTab = "kanban"' style="white-space: nowrap;">
                📊 Kanban of Doom
            </button>
            <button class="btn @(activeTab == "dag" ? "btn-primary" : "btn-secondary")" @onclick='() => activeTab = "dag"' style="white-space: nowrap;">
                🌳 Decomposition Tree
            </button>
            <button class="btn @(activeTab == "handoffs" ? "btn-primary" : "btn-secondary")" @onclick='() => activeTab = "handoffs"' style="white-space: nowrap;">
                📦 Handoff Logs (@ScopedHandoffs.Count)
            </button>
            <button class="btn btn-warning" @onclick="UnleashReadyAgents" disabled="@(ScopedReadyTickets.Count(t => t.Type != TicketType.Epic && t.Status != TicketStatus.Done) == 0 || isRunningCircus)" style="white-space: nowrap; font-weight: 700;">
                @(isRunningCircus ? "⏳ Agents Executing..." : $"🚀 Unleash Ready Agents ({ScopedReadyTickets.Count(t => t.Type != TicketType.Epic && t.Status != TicketStatus.Done)})")
            </button>
            <button class="btn btn-success" @onclick="() => showCreateModal = true" style="white-space: nowrap;">
                ➕ New Ticket
            </button>
        </div>
    }
</div>

@if (!ActiveProjectContext.HasActiveProject)
{
    <div class="glass-card" style="text-align: center; padding: 48px;">
        <div style="font-size: 2rem; margin-bottom: 12px;">📁</div>
        <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 8px;">Select a project to view tickets</h3>
        <p style="color: var(--text-muted);">Tickets are scoped to a project. Choose or create an active project from the sidebar switcher.</p>
    </div>
}
else if (activeTab == "kanban")
{
    <div class="kanban-board">
        @foreach (var status in Enum.GetValues<TicketStatus>())
        {
            var ticketsInCol = ScopedTickets.Where(t => t.Status == status).ToList();
            var statusSubtitle = status switch
            {
                TicketStatus.Backlog => "Where Dreams Go to Die ('Our pets' heads are falling off!')",
                TicketStatus.Ready => "Primed for Action ('So you're telling me there's a chance!')",
                TicketStatus.InProgress => "Creating Tech Debt at Ludicrous Speed ('They've gone to plaid!')",
                TicketStatus.Review => "Peer Nitpicking ('Nice PR! Thanks, I just had it stuffed.')",
                TicketStatus.Remediating => "Atoning for Sins ('Tis but a scratch! Just a flesh wound')",
                TicketStatus.Done => "Shipped & Prayed For ('Like a glove! Alllllrighty then!')",
                TicketStatus.Blocked => "Blaming Architecture ('Somebody's gotta go back & get a shitload of dimes!')",
                _ => ""
            };

            <div class="kanban-column">
                <div class="kanban-header" style="border-top: 3px solid @status.ToColorHex(); display: flex; flex-direction: column; align-items: flex-start; gap: 2px;">
                    <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                        <span style="color: @status.ToColorHex(); font-weight: 700;">@status</span>
                        <span class="badge" style="background: rgba(255,255,255,0.08);">@ticketsInCol.Count</span>
                    </div>
                    <div style="font-size: 0.65rem; color: var(--text-muted); font-style: italic;">@statusSubtitle</div>
                </div>
                <div class="kanban-cards">
                    @foreach (var ticket in ticketsInCol)
                    {
                        <TicketCard Ticket="@ticket" OnSelect="SelectTicket" />
                    }
                    @if (ticketsInCol.Count == 0)
                    {
                        <div style="color: var(--text-muted); font-size: 0.78rem; text-align: center; margin-top: 20px; font-style: italic;">
                            No tickets (Suspiciously quiet...)
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else if (activeTab == "dag")
{
    <div class="glass-card">
        <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 16px;">Hierarchical Backlog Decomposition Tree</h3>
        @{
            var epics = ScopedTickets.Where(t => t.Type == TicketType.Epic).ToList();
        }
        @if (epics.Count == 0)
        {
            <p style="color: var(--text-muted);">No epics decomposed yet. Click "🚀 New Project" in the top bar to ignite an initiative.</p>
        }
        @foreach (var epic in epics)
        {
            <div style="margin-bottom: 24px; background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 8px; padding: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
                    <div>
                        <span class="badge" style="background: #a855f7; color: #fff; margin-right: 8px;">EPIC</span>
                        <span style="font-weight: 700; font-size: 1.05rem;">@epic.Title</span>
                        <span style="font-family: monospace; font-size: 0.75rem; color: var(--text-muted); margin-left: 6px;">@epic.Id</span>
                    </div>
                    <span class="badge" style="background: @epic.Status.ToColorHex(); color: #000; font-weight: 700;">@epic.Status</span>
                </div>
                <div style="color: var(--text-muted); font-size: 0.85rem; margin-top: 8px; margin-bottom: 12px;">@epic.Description</div>

                <!-- Subtasks -->
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px;">
                    @foreach (var child in TicketStore.GetTicketsByEpic(epic.Id))
                    {
                        <div style="background: var(--bg-secondary); border-left: 3px solid @child.AssigneeRole.ToColorHex(); border-radius: 6px; padding: 10px; cursor: pointer;" @onclick="() => SelectTicket(child)">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px;">
                                <span style="font-weight: 700; font-size: 0.85rem; color: #f8fafc;">@child.Title</span>
                                <span class="badge" style="background: @child.Status.ToColorHex(); font-size: 0.65rem; color: #000; font-weight: 700;">@child.Status</span>
                            </div>
                            <div style="font-size: 0.72rem; color: var(--text-muted);">
                                <span>@child.AssigneeRole.ToEmoji() @child.AssigneeRole.ToDisplayName()</span> • <span>@child.Type</span>
                            </div>
                            @if (child.DependsOnTicketIds.Count > 0)
                            {
                                <div style="font-size: 0.68rem; color: #eab308; margin-top: 4px;">
                                    🔗 Blocked by: @string.Join(", ", child.DependsOnTicketIds)
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else if (activeTab == "handoffs")
{
    <div class="glass-card">
        <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 16px;">Formal Inter-Agent Handoff Chain</h3>
        <div style="display: flex; flex-direction: column; gap: 12px;">
            @foreach (var handoff in ScopedHandoffs)
            {
                <div style="background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 8px; padding: 14px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; flex-wrap: wrap; gap: 8px;">
                        <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 0.9rem;">
                            <span style="color: @handoff.FromAgentRole.ToColorHex();">@handoff.FromAgentRole.ToEmoji() @handoff.FromAgentRole.ToDisplayName()</span>
                            <span>➔</span>
                            <span style="color: @handoff.ToAgentRole.ToColorHex();">@handoff.ToAgentRole.ToEmoji() @handoff.ToAgentRole.ToDisplayName()</span>
                        </div>
                        <span style="font-size: 0.75rem; color: var(--text-muted);">
                            @handoff.Timestamp.ToString("yyyy-MM-dd HH:mm:ss") • Ticket <strong style="color: #38bdf8;">@handoff.TicketId</strong>
                        </span>
                    </div>

                    <div style="font-size: 0.85rem; color: var(--text-main); margin-bottom: 8px;">
                        @handoff.ContextSummary
                    </div>

                    @if (handoff.Artifacts.Count > 0)
                    {
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 4px;">Transferred Deliverables:</div>
                        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                            @foreach (var item in handoff.Artifacts)
                            {
                                <span class="badge" style="background: rgba(56, 189, 248, 0.1); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">
                                    📄 @item.Name (@item.ContentType)
                                </span>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(handoff.RemediationNotes))
                    {
                        <div style="margin-top: 8px; padding: 8px; border-radius: 6px; background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #fca5a5; font-size: 0.8rem;">
                            <strong>🔴 Rejection / Blame Context:</strong> @handoff.RemediationNotes
                        </div>
                    }
                </div>
            }
            @if (ScopedHandoffs.Count == 0)
            {
                <p style="color: var(--text-muted); text-align: center; padding: 30px;">No handoff transfers registered yet.</p>
            }
        </div>
    </div>
}

@if (selectedTicket != null)
{
    <TicketModal Ticket="@selectedTicket" OnClose="() => selectedTicket = null" />
}

@if (showCreateModal)
{
    <div class="modal-backdrop" @onclick="() => showCreateModal = false">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 style="font-size: 1.1rem; font-weight: 700;">➕ Create New Ticket</h3>
                <button class="btn btn-secondary" @onclick="() => showCreateModal = false" style="padding: 2px 8px;">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Ticket Title</label>
                    <input class="form-control" @bind="newTitle" placeholder="e.g. Implement Zero-Allocation Token Stream" />
                </div>
                <div class="form-group">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" rows="3" @bind="newDesc" placeholder="Implementation details and acceptance criteria..."></textarea>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div class="form-group">
                        <label class="form-label">Assignee Role</label>
                        <select class="form-control" @bind="newAssignee">
                            @foreach (AgentRole r in Enum.GetValues(typeof(AgentRole)))
                            {
                                <option value="@r">@r.ToEmoji() @r.ToDisplayName()</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Ticket Type</label>
                        <select class="form-control" @bind="newType">
                            @foreach (TicketType t in Enum.GetValues(typeof(TicketType)))
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showCreateModal = false">Cancel</button>
                <button class="btn btn-success" @onclick="CreateTicketManual">Create Ticket</button>
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "kanban";
    private TicketItem? selectedTicket;
    private bool showCreateModal;
    private bool isRunningCircus;

    private string newTitle = "";
    private string newDesc = "";
    private AgentRole newAssignee = AgentRole.SoftwareDeveloper;
    private TicketType newType = TicketType.Subtask;

    private IReadOnlyList<TicketItem> ScopedTickets =>
        ActiveProjectContext.CurrentProjectId is { } projectId
            ? TicketStore.GetByProject(projectId)
            : Array.Empty<TicketItem>();

    private IReadOnlyList<TicketItem> ScopedReadyTickets =>
        ActiveProjectContext.CurrentProjectId is { } projectId
            ? TicketStore.GetReadyTickets().Where(t => string.Equals(t.ProjectId, projectId, StringComparison.OrdinalIgnoreCase)).ToList()
            : Array.Empty<TicketItem>();

    private IReadOnlyList<HandoffPacket> ScopedHandoffs =>
        ActiveProjectContext.CurrentProjectId is { } projectId
            ? TicketStore.GetAllHandoffs().Where(h => string.Equals(h.ProjectId, projectId, StringComparison.OrdinalIgnoreCase)).ToList()
            : Array.Empty<HandoffPacket>();

    protected override void OnInitialized()
    {
        TicketStore.OnTicketChanged += HandleTicketChanged;
        ActiveProjectContext.OnActiveProjectChanged += HandleActiveProjectChanged;
    }

    private void HandleTicketChanged(TicketItem _)
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleActiveProjectChanged(Project? _)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TicketStore.OnTicketChanged -= HandleTicketChanged;
        ActiveProjectContext.OnActiveProjectChanged -= HandleActiveProjectChanged;
    }

    private void SelectTicket(TicketItem ticket)
    {
        selectedTicket = ticket;
    }

    private async Task UnleashReadyAgents()
    {
        try
        {
            isRunningCircus = true;
            await GraphExecutor.ExecuteReadyTicketsAsync();
        }
        finally
        {
            isRunningCircus = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CreateTicketManual()
    {
        if (string.IsNullOrWhiteSpace(newTitle) || !ActiveProjectContext.HasActiveProject) return;

        var id = $"TCK-{Guid.NewGuid().ToString("N")[..6].ToUpperInvariant()}";
        var ticket = new TicketItem(
            Id: id,
            ProjectId: ActiveProjectContext.CurrentProjectId,
            ParentEpicId: null,
            Title: newTitle,
            Description: newDesc,
            Type: newType,
            Status: TicketStatus.Ready,
            AssigneeRole: newAssignee,
            CreatedByRole: AgentRole.TechnicalProductManager,
            Priority: TicketPriority.Medium,
            DependsOnTicketIds: Array.Empty<string>(),
            AcceptanceCriteria: ["Meets implementation standards"],
            Deliverables: Array.Empty<ArtifactItem>(),
            Metadata: new Dictionary<string, string>(),
            CreatedAt: DateTimeOffset.UtcNow
        );
        TicketStore.CreateTicket(ticket);
        showCreateModal = false;
        newTitle = "";
        newDesc = "";
    }
}
