<Project>
  <PropertyGroup>
    <Authors>Carnot Cycle Circus Contributors</Authors>
    <Company>Carnot Cycle Circus</Company>
    <Copyright>Copyright © 2026-$([System.DateTime]::Now.Year) Carnot Cycle Circus Contributors</Copyright>
    <Product>Carnot Cycle Circus</Product>
    <PackageProjectUrl>https://github.com/chadahoochie/carnot-cycle-circus</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chadahoochie/carnot-cycle-circus</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <PackageReleaseNotes>See RELEASE_NOTES.md</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
