# Carnot Cycle Circus - Environment Configuration
# Copy this file to .env and adjust variables as needed

# Application Environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Production

# Port to bind
ASPNETCORE_HTTP_PORTS=5000

# Persistent Data Storage Directory (Default: /app/data inside container)
CARNOT_DATA_DIR=/app/data

# Autonomous Self-Improvement Cycle Interval in Seconds (Default: 300 = 5 minutes)
CARNOT_SELF_IMPROVEMENT_INTERVAL_SECONDS=300

# OpenRouter API Key (Optional fallback if not configured in Web Key Vault UI)
OPENROUTER_API_KEY=
